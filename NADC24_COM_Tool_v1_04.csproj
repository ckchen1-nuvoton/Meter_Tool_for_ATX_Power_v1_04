    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{4A57CC66-763C-429B-A280-8D712E1ABAAD}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Nuvoton_PSU_Meter</RootNamespace>
    <AssemblyName>Nuvoton PSU Meter</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <!-- Form1.resx 內含非字串資源(點陣圖/圖示)。用 dotnet CLI 的 MSBuild 建置時，
         GenerateResource 需要這個屬性 + System.Resources.Extensions 參考，
         否則會出現 MSB3823 / MSB3822。Visual Studio 的 MSBuild 不需要，
         但兩者都設著沒有副作用。 -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <!-- 只複製參考組件本身，不要跟著複製它們的 .xml (IntelliSense 文件) 與 .pdb，
         Release 產出只留執行真正需要的檔案。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>nadc24.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 已移除 Endorphin.Core / Endorphin.Core.NationalInstruments / EPPlus /
         EPPlus.Interfaces / EPPlus.System.Drawing / Microsoft.IO.RecyclableMemoryStream。
         原始碼完全沒有引用它們 (EPPlus 只剩一行 IDE 自動加入的 using static，
         Endorphin 連一次都沒出現)，且 Endorphin 是 F# 組件卻沒有部署 FSharp.Core，
         代表它從來沒有在執行階段被載入過。Excel 匯出走的是
         Microsoft.Office.Interop.Excel，與 EPPlus 無關，仍然保留。 -->
    <Reference Include="Ivi.Visa, Version=7.2.0.0, Culture=neutral, PublicKeyToken=a128c98f1d7717c1, processorArchitecture=MSIL">
      <HintPath>packages\Kelary.Ivi.Visa.7.2.0\lib\net20\Ivi.Visa.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.Excel, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c, processorArchitecture=MSIL">
      <HintPath>packages\Microsoft.Office.Interop.Excel.15.0.4795.1001\lib\net20\Microsoft.Office.Interop.Excel.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <!-- 原本指向 ..\..\Program Files (x86)\...\NI VISA.NET 24.5\，那是相對於專案位置的
         路徑，專案一搬家或換一台沒裝同版 NI-VISA 的機器就解析不到 (MSB3245)。
         改放專案內的 lib\，與 App.config 既有的 19.0.0.49152 binding redirect 一致。 -->
    <Reference Include="NationalInstruments.Visa, Version=19.0.0.49152, Culture=neutral, PublicKeyToken=2eaa5af0834e221d, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>lib\NationalInstruments.Visa.dll</HintPath>
    </Reference>
    <!-- 非字串資源 (Form1.resx 內的圖片) 在建置與執行階段都需要 System.Resources.Extensions，
         其餘四個是它的相依組件。 -->
    <Reference Include="System.Resources.Extensions">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>packages\System.Resources.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="System.Buffers">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>packages\System.Buffers.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
