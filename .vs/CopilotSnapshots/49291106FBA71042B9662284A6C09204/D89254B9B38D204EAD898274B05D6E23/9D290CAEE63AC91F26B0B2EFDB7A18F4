        #region Frame helpers

        // ===== 送包共用 helper =====
        // 原本每送一個命令都要手工重複「組 core → 算 SumZero → 補一個 byte → Write → Sleep」，
        // 這裡收斂成一處，新增命令只要一行。

        // 組上 SumZero 後送出。core 不含檢查碼。
        private void SendFrame(byte[] core, int waitMs)
        {
            if (!serialPort1.IsOpen) return;

            serialPort1.DiscardInBuffer();
            receiveBuffer.Clear();

            byte[] frame = new byte[core.Length + 1];
            Array.Copy(core, frame, core.Length);
            frame[core.Length] = new SumZeroCalculator().CalculateSumZero(core);

            serialPort1.Write(frame, 0, frame.Length);
            if (waitMs > 0) Thread.Sleep(waitMs);
        }

        // 無參數命令：{ 0x49, 0x01, cmd, SumZero }
        private void SendCaliCmd(byte cmd, int waitMs)
        {
            SendFrame(new byte[] { 0x49, 0x01, cmd }, waitMs);
        }

        // Generate Calibration Value 產生的數字是用 InvariantCulture 格式化的，但手動輸入的
        // 欄位可能是照使用者地區設定打的。先試 Invariant，再退回目前地區，兩種都收。
        private static bool TryParseFloatFlexible(string text, out float value)
        {
            if (float.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value))
                return true;
            return float.TryParse(text, out value);
        }

        // 定點參數命令：{ 0x49, 0x05, cmd, MSB..LSB, SumZero }，值 = text * scale 取整。
        // 給 WRITE_xx_CALI_P1 這類三點校正命令使用（V*1000 / I*128000 / P*1000）。
        private void SendCaliWrite(byte cmd, string text, float scale, int waitMs = 200)
        {
            TryParseFloatFlexible(text, out float v);
            int iv = Convert.ToInt32(v * scale);
            SendFrame(new byte[] { 0x49, 0x05, cmd,
                (byte)((iv >> 24) & 0xFF), (byte)((iv >> 16) & 0xFF),
                (byte)((iv >>  8) & 0xFF), (byte)(iv & 0xFF) }, waitMs);
        }

        // float → big-endian 4 bytes（IEEE754 原始位元樣式）
        private static byte[] FloatToBigEndianBytes(float value)
        {
            byte[] b = BitConverter.GetBytes(value);   // x86 為 little-endian
            if (BitConverter.IsLittleEndian)
                Array.Reverse(b);
            return b;
        }

        // 浮點參數命令：4 個 byte 直接是 float 的位元樣式，不做定點縮放。
        // 補償參數專用 —— 這些值有負數、且輕載係數需要遠高於定點所能表示的精度。
        private void SendCompWrite(byte cmd, string text)
        {
            TryParseFloatFlexible(text, out float v);
            byte[] b = FloatToBigEndianBytes(v);
            SendFrame(new byte[] { 0x49, 0x05, cmd, b[0], b[1], b[2], b[3] }, 200);
        }

