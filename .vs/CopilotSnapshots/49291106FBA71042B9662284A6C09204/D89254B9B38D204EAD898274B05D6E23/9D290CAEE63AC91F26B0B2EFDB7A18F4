        public class SumZeroCalculator
        {
            public byte CalculateSumZero(byte[] data)
            {
                byte sum = 0;

                // Summing the data
                foreach (byte b in data)
                {
                    sum += b;
                }

                // Two's complement
                byte sumZero = (byte)(0xFF - sum + 1);
                return sumZero;
            }
        }
        #region Accuracy table (tab 1)

        // 一個負載點的量測結果：外部儀器(參考) 與 MCU(NADC24) 各三個值。
        private sealed class SweepPoint
        {
            public int Percent;          // 負載百分比 5, 10, ... 100
            public double SetCurrent;    // 送給電子負載的設定電流 (A)
            public double RefV, RefI, RefP;   // Chroma / WT310E 讀值
            public double McuV, McuI, McuP;   // NADC24 讀值
        }

        private readonly List<SweepPoint> sweepPoints = new List<SweepPoint>();

        // 誤差% = (參考值 - 量測值) / 參考值 * 100
        // 與 800W_PGA32算法.xlsx 的電壓/電流/功率誤差欄位定義一致。
        private static string ErrPct(double reference, double measured)
        {
            if (reference == 0) return "";
            return (((reference - measured) / reference) * 100.0).ToString("F3", CultureInfo.InvariantCulture);
        }

        // 重新掃描前呼叫：清空累積的資料與表格。
        private void ResetAccuracyTable()
        {
            sweepPoints.Clear();
            accuracy_grid.Rows.Clear();
            accuracy_grid.Columns.Clear();
        }

        // 依 xlsx 的版面重畫表格：每個負載點一欄，量測項目一列。
        private void RefreshAccuracyTable()
        {
            if (accuracy_grid.InvokeRequired)
            {
                accuracy_grid.Invoke((Action)RefreshAccuracyTable);
                return;
            }

            accuracy_grid.Rows.Clear();
            accuracy_grid.Columns.Clear();
            if (sweepPoints.Count == 0) return;

            // 第一欄是項目名稱，之後每個負載點一欄
            accuracy_grid.Columns.Add("item", "Item");
            accuracy_grid.Columns[0].Width = 108;
            accuracy_grid.Columns[0].DefaultCellStyle.Font =
                new Font(accuracy_grid.Font, FontStyle.Bold);
            accuracy_grid.Columns[0].Frozen = true;   // 橫向捲動時項目名稱固定

            foreach (var p in sweepPoints)
            {
                int idx = accuracy_grid.Columns.Add("p" + p.Percent, p.Percent + "%");
                accuracy_grid.Columns[idx].Width = 72;
                accuracy_grid.Columns[idx].DefaultCellStyle.Alignment =
                    DataGridViewContentAlignment.MiddleRight;
                accuracy_grid.Columns[idx].SortMode = DataGridViewColumnSortMode.NotSortable;
            }

            // 誤差擺在最上面 —— 這一頁的重點就是精準度，不必捲動就要看得到
            AddAccuracyRow("Voltage err %", p => ErrPct(p.RefV, p.McuV), true);
            AddAccuracyRow("Current err %", p => ErrPct(p.RefI, p.McuI), true);
            AddAccuracyRow("Power err %",   p => ErrPct(p.RefP, p.McuP), true);

            AddAccuracyRow("Set current A", p => p.SetCurrent.ToString("F2", CultureInfo.InvariantCulture), false);
            AddAccuracyRow("Ref Vrms",      p => p.RefV.ToString("F2", CultureInfo.InvariantCulture), false);
            AddAccuracyRow("Ref Irms",      p => p.RefI.ToString("F4", CultureInfo.InvariantCulture), false);
            AddAccuracyRow("Ref Pactive",   p => p.RefP.ToString("F2", CultureInfo.InvariantCulture), false);
            AddAccuracyRow("NADC24 Vrms",   p => p.McuV.ToString("F2", CultureInfo.InvariantCulture), false);
            AddAccuracyRow("NADC24 Irms",   p => p.McuI.ToString("F5", CultureInfo.InvariantCulture), false);
            AddAccuracyRow("NADC24 Pactive",p => p.McuP.ToString("F3", CultureInfo.InvariantCulture), false);

            accuracy_grid.ClearSelection();
        }

        private void AddAccuracyRow(string title, Func<SweepPoint, string> cell, bool isError)
        {
            var values = new List<object> { title };
            foreach (var p in sweepPoints) values.Add(cell(p));

            int r = accuracy_grid.Rows.Add(values.ToArray());

            if (!isError) return;

            // 誤差列上色：|err| > 1% 標紅，> 0.5% 標橘，其餘綠色，一眼看出哪個負載點超規
            for (int c = 1; c < accuracy_grid.Columns.Count; c++)
            {
                string s = accuracy_grid.Rows[r].Cells[c].Value as string;
                if (string.IsNullOrEmpty(s)) continue;
                if (!double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out double v)) continue;

                double a = Math.Abs(v);
                accuracy_grid.Rows[r].Cells[c].Style.ForeColor =
                    a > 1.0 ? Color.Firebrick : (a > 0.5 ? Color.DarkOrange : Color.ForestGreen);
            }
        }

        // 掃描迴圈每量完一個負載點就呼叫這裡累積一筆並即時更新畫面。
        private void AddSweepPoint(int percent, double setCurrent,
                                   double refV, double refI, double refP,
                                   double mcuV, double mcuI, double mcuP)
        {
            sweepPoints.Add(new SweepPoint
            {
                Percent = percent,
                SetCurrent = setCurrent,
                RefV = refV, RefI = refI, RefP = refP,
                McuV = mcuV, McuI = mcuI, McuP = mcuP
            });
            RefreshAccuracyTable();
        }

        // ===== Export CSV =====
        // 掃描結果只留在畫面上，關掉程式就沒了；報告和後續比對都要原始數字，
        // 所以這裡把表格原樣（項目為列、負載點為欄）倒成 CSV。
        // 數值一律用 InvariantCulture 輸出，小數點固定是 '.'，換到其他語系的機器
        // 才不會變成逗號而撞到欄位分隔符號。
        private void export_accuracy_btn_Click(object sender, EventArgs e)
        {
            if (sweepPoints.Count == 0)
            {
                SetStatus(StatusLevel.Warn, "Export CSV: no measurement data - run a sweep first.");
                return;
            }

            using (var dlg = new SaveFileDialog())
            {
                dlg.Title = "Export Accuracy";
                dlg.Filter = "CSV file (*.csv)|*.csv|All files (*.*)|*.*";
                dlg.DefaultExt = "csv";
                dlg.AddExtension = true;
                dlg.FileName = "Accuracy_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".csv";

                if (dlg.ShowDialog(this) != DialogResult.OK) return;

                try
                {
                    // UTF-8 with BOM，讓 Excel 直接雙擊開啟時不會亂碼
                    File.WriteAllText(dlg.FileName, BuildAccuracyCsv(), new UTF8Encoding(true));
                    SetStatus(StatusLevel.Info, $"Accuracy exported - {dlg.FileName}");
                }
                catch (Exception ex)
                {
                    SetStatus(StatusLevel.Error, "Export CSV failed - " + ex.Message);
                }
            }
        }

        // 版面與 accuracy_grid 一致：第一欄是項目名稱，其後每個負載點一欄。
        private string BuildAccuracyCsv()
        {
            var sb = new StringBuilder();

            sb.Append("Exported,").AppendLine(CsvCell(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")));
            sb.Append("Points,").AppendLine(sweepPoints.Count.ToString(CultureInfo.InvariantCulture));
            sb.AppendLine();

            sb.Append("Item");
            foreach (var pt in sweepPoints)
                sb.Append(',').Append(pt.Percent.ToString(CultureInfo.InvariantCulture)).Append('%');
            sb.AppendLine();

            AppendCsvRow(sb, "Voltage err %",  pt => ErrPct(pt.RefV, pt.McuV));
            AppendCsvRow(sb, "Current err %",  pt => ErrPct(pt.RefI, pt.McuI));
            AppendCsvRow(sb, "Power err %",    pt => ErrPct(pt.RefP, pt.McuP));

            AppendCsvRow(sb, "Set current A",  pt => pt.SetCurrent.ToString("F2", CultureInfo.InvariantCulture));
            AppendCsvRow(sb, "Ref Vrms",       pt => pt.RefV.ToString("F2", CultureInfo.InvariantCulture));
            AppendCsvRow(sb, "Ref Irms",       pt => pt.RefI.ToString("F4", CultureInfo.InvariantCulture));
            AppendCsvRow(sb, "Ref Pactive",    pt => pt.RefP.ToString("F2", CultureInfo.InvariantCulture));
            AppendCsvRow(sb, "NADC24 Vrms",    pt => pt.McuV.ToString("F2", CultureInfo.InvariantCulture));
            AppendCsvRow(sb, "NADC24 Irms",    pt => pt.McuI.ToString("F5", CultureInfo.InvariantCulture));
            AppendCsvRow(sb, "NADC24 Pactive", pt => pt.McuP.ToString("F3", CultureInfo.InvariantCulture));

            return sb.ToString();
        }

        private void AppendCsvRow(StringBuilder sb, string title, Func<SweepPoint, string> cell)
        {
            sb.Append(CsvCell(title));
            foreach (var pt in sweepPoints) sb.Append(',').Append(CsvCell(cell(pt)));
            sb.AppendLine();
        }

        // 逗號、雙引號、換行都得包起來，否則欄位在 Excel 裡會錯位。
        private static string CsvCell(string text)
        {
            text = text ?? "";
            return text.IndexOfAny(new[] { ',', '"', '\r', '\n' }) >= 0
                 ? "\"" + text.Replace("\"", "\"\"") + "\""
                 : text;
        }

