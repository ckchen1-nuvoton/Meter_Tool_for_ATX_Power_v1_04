        private void button1_Click(object sender, EventArgs e)
        {
            try
            {
                if (serialPort1.IsOpen == false)
                {
                    // port_cbb 顯示的是友善名稱（例 "Silico..(COM11)"），必須先萃取出 COMxx
                    serialPort1.PortName = parsePortName(port_cbb.Text);
                    //serialPort1.BaudRate = Convert.ToInt32(speed_cbb.Text);
                    //serialPort1.DataBits = Convert.ToInt32(data_cbb.Text);
                    serialPort1.BaudRate = 115200;
                    serialPort1.DataBits = 8;
                    serialPort1.Parity = Parity.None;
                    serialPort1.StopBits = StopBits.One;
                    serialPort1.RtsEnable = false;
                    serialPort1.DtrEnable = false;
                    /*
                    switch (parity_cbb.SelectedIndex)
                    {
                        // None, Odd, Even
                        case 0:
                            serialPort1.Parity = Parity.None;
                            break;
                        case 1:
                            serialPort1.Parity = Parity.Odd;
                            break;
                        case 2:
                            serialPort1.Parity = Parity.Even;
                            break;
                        default:
                            serialPort1.Parity = Parity.None;
                            break;
                    }
                    
                    switch (stop_cbb.SelectedIndex)
                    {
                        // 1, 1.5, 2 bit
                        case 0:
                            serialPort1.StopBits = StopBits.One;
                            break;
                        case 1:
                            serialPort1.StopBits = StopBits.OnePointFive;
                            break;
                        case 2:
                            serialPort1.StopBits = StopBits.Two;
                            break;
                        default:
                            serialPort1.StopBits = StopBits.One;
                            break;
                    }
                    */

                    serialPort1.Open();
                    connection_btn.Text = "Close";
                    SetStatus(StatusLevel.Info, $"Connected with {serialPort1.PortName}");
                    // 插拔序列埠時 MCU 並不會停止送 UART，開埠當下驅動層緩衝區裡幾乎一定是
                    // 從封包中間開始的半截資料，直接收就會錯位（第一個 byte 不是 0x49）。
                    // 先等 100ms 讓線上正在送的那一包走完，再把驅動層與程式端的緩衝區一起
                    // 清乾淨，最後才掛上 DataReceived，確保是從乾淨狀態開始收。
                    Thread.Sleep(100);  // Delay 100ms

                    // Clear the serial port receive buffer data
                    try { serialPort1.DiscardInBuffer(); } catch { }
                    try { serialPort1.DiscardOutBuffer(); } catch { }
                    ResetReceiveState();

                    // Send stop command
                    //byte[] myBytes1 = { 0x49, 0x01, 0x71, 0x00, 0xD4, 0x19  };
                    //serialPort1.Write(myBytes1, 0, myBytes1.Length); // Write out 7 bytes of data
                    //Thread.Sleep(100);  // Delay 100ms
                    //

                    // Start the calculation thread
                    //thread1 = new Thread(new ThreadStart(DoWork1));
                    //thread1.Start();
                    //isThread1Running = true;

                    // Chart            
                    // Start the Timer control
                    timer.Start();

                    // Bind the DataReceived event handler
                    serialPort1.DataReceived += new SerialDataReceivedEventHandler(DataReceivedHandler);
                }
                else
                {
                    // 關閉順序很重要：
                    //  1. 先停 Timer，圖表才不會在關埠後繼續捲動
                    //  2. 先解除 DataReceived 訂閱，避免 Close() 等待回呼執行緒時卡死
                    //  3. DiscardInBuffer() 必須在 Close() 之「前」呼叫 —— 對已關閉的埠
                    //     呼叫會丟 InvalidOperationException，原本的順序會讓例外中斷後面
                    //     的 timer.Stop()，並讓 catch 顯示誤導的 "Cannot open"。
                    string closingPort = serialPort1.PortName;

                    // Chart : stop the Timer control
                    timer.Stop();

                    // Unbind the DataReceived event handler
                    serialPort1.DataReceived -= new SerialDataReceivedEventHandler(DataReceivedHandler);

                    // Clear the serial port receive buffer data (while the port is still open)
                    try { serialPort1.DiscardInBuffer(); } catch { }
                    try { serialPort1.DiscardOutBuffer(); } catch { }
                    ResetReceiveState();

                    serialPort1.Close();

                    // 解除訂閱到真正關埠之間可能還有一個回呼把資料塞進來，關完再清一次，
                    // 這樣下次 Open 一定是從空的緩衝區開始，不會與上次的殘料黏在一起。
                    ResetReceiveState();

                    connection_btn.Text = "Open";
                    SetStatus(StatusLevel.Info, $"Disconnected with {closingPort}");
                }
            }
            catch (Exception ex)
            {
                // Handle exceptions
                Console.WriteLine("Error : " + ex.Message);

                // 開啟與關閉要分開報，否則關閉失敗也會顯示 "Cannot open"
                string action = serialPort1.IsOpen ? "close" : "open";
                SetStatus(StatusLevel.Error, $"Cannot {action} {serialPort1.PortName} - {ex.Message}");
            }
        }

