        // 從顯示名稱取回真正的埠名："Silico..(COM11)" → "COM11"。
        // port_cbb 現在顯示的是友善名稱，開埠前一定要先過這一層。
        private string parsePortName(string displayName)
        {
            if (string.IsNullOrEmpty(displayName))
                return displayName;

            var match = System.Text.RegularExpressions.Regex.Match(displayName, @"COM\d+", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (match.Success)
            {
                return match.Value.ToUpper();
            }
            return displayName;
        }

        // 把 WMI 的裝置全名縮短成下拉塞得下的長度：
        // "Silicon Labs CP210x USB to UART Bridge (COM11)" → "Silico..(COM11)"
        private string FormatPortName(string caption)
        {
            if (string.IsNullOrEmpty(caption))
                return caption;

            int comIndex = caption.LastIndexOf("(COM", StringComparison.OrdinalIgnoreCase);
            if (comIndex > 0)
            {
                string devName = caption.Substring(0, comIndex).Trim();
                string comPart = caption.Substring(comIndex).Trim(); // e.g., "(COM11)"

                StringBuilder sb = new StringBuilder();
                foreach (char c in devName)
                {
                    if (char.IsLetterOrDigit(c))
                    {
                        sb.Append(c);
                        if (sb.Length == 6)
                            break;
                    }
                }

                string prefix = sb.ToString();
                if (prefix.Length == 0)
                {
                    prefix = devName.Length > 6 ? devName.Substring(0, 6) : devName;
                }

                if (devName.Length > sb.Length)
                {
                    prefix += "..";
                }

                return prefix + comPart;
            }
            return caption;
        }

        // COM 埠掃描：登錄檔列出實際存在的埠，再用 WMI 補上裝置友善名稱。
        // 整段跑在背景執行緒，WMI 查詢可能要一兩秒，放前景會讓視窗假死。
        private void serialLoad()
        {
            if (InvokeRequired) { Invoke((Action)serialLoad); return; }
            port_cbb.Items.Clear();

            Task.Run(() =>
            {
                var activePorts = new List<string>();
                try
                {
                    using (RegistryKey keyCom = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DeviceMap\SerialComm"))
                    {
                        if (keyCom != null)
                        {
                            foreach (var sValue in keyCom.GetValueNames())
                            {
                                string portName = (string)keyCom.GetValue(sValue);
                                if (!string.IsNullOrEmpty(portName))
                                    activePorts.Add(portName);
                            }
                        }
                    }
                }
                catch (Exception ex) { Console.WriteLine($"Registry scan error: {ex.Message}"); }

                var portFriendlyNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                try
                {
                    using (var searcher = new ManagementObjectSearcher("SELECT Caption FROM Win32_PnPEntity WHERE Caption LIKE '%(COM%'"))
                    {
                        foreach (var mObj in searcher.Get())
                        {
                            string caption = mObj["Caption"]?.ToString();
                            if (!string.IsNullOrEmpty(caption))
                            {
                                string comPort = parsePortName(caption);
                                if (!string.IsNullOrEmpty(comPort) && !portFriendlyNames.ContainsKey(comPort))
                                    portFriendlyNames[comPort] = FormatPortName(caption);
                            }
                        }
                    }
                }
                catch (Exception ex) { Console.WriteLine($"WMI scan error: {ex.Message}"); }

                Invoke((Action)(() =>
                {
                    port_cbb.Items.Clear();
                    foreach (string port in activePorts)
                    {
                        if (portFriendlyNames.TryGetValue(port, out string displayName))
                            port_cbb.Items.Add(displayName);
                        else
                            port_cbb.Items.Add(port);
                    }
                    if (port_cbb.Items.Count > 0)
                        port_cbb.SelectedIndex = 0;
                }));
            });
        }

