        // ===== RMS Value / DC Value 掃描流程的啟停控制 =====
        // 原本按下去就一路跑到底：中途發現接線、負載規格或量測結果不對也停不下來，
        // 只能等 repeat × 20 個負載點全部跑完，或直接把程式關掉。
        // 而且整段流程從頭到尾沒有對電子負載下過 LOAD ON —— CURR:STAT:L1 只是「要拉多少電流」，
        // 真正把負載接上去的是 LOAD ON，少了它就得靠負載面板剛好還開著才量得到東西。
        //
        // 改成（作法比照 Data.cs 的 RunSweepAsync）：
        //   1. 按下 RMS Value / DC Value → 該顆按鈕就地變成 Stop，再按一次即中斷。
        //   2. 流程開頭 *CLS → 電流歸零 → LOAD ON。
        //   3. 不論正常跑完、丟例外或使用者中斷，finally 一律電流歸零 + LOAD OFF。
        private CancellationTokenSource sweepCts;
        private Button sweepButton;         // 目前被借去當 Stop 的那一顆
        private string sweepButtonText;     // 借用前的字樣，收尾時復歸
        private Color sweepButtonColor;

        private bool SweepRunning => sweepCts != null;

        // 把 owner 借去當 Stop，另一顆掃描按鈕停用，避免兩段流程同時對同一台負載下命令。
        private void BeginSweepUi(Button owner, Button other)
        {
            sweepCts = new CancellationTokenSource();
            sweepButton = owner;
            sweepButtonText = owner.Text;
            sweepButtonColor = owner.ForeColor;

            owner.Text = "Stop";
            owner.ForeColor = Color.Firebrick;
            if (other != null) other.Enabled = false;

            // 掃描中不准 Disconnect：session 一旦被關掉，收尾就送不出 LOAD OFF，
            // 負載會被留在拉載的狀態。要停請按 Stop，收完尾再斷線。
            visa_connect_btn.Enabled = false;
        }

        // 按鈕字樣與啟用狀態復歸，讓下一輪可以重新開始。
        private void EndSweepUi(Button other)
        {
            if (sweepButton != null)
            {
                sweepButton.Text = sweepButtonText;
                sweepButton.ForeColor = sweepButtonColor;
                sweepButton = null;
            }

            if (other != null) other.Enabled = true;
            visa_connect_btn.Enabled = true;

            try { sweepCts?.Dispose(); } catch { }
            sweepCts = null;
        }

        // 按下 Stop 只送出取消要求；歸零與 LOAD OFF 一律交給掃描流程的 finally 收尾，
        // 避免這裡與流程本身同時對負載下命令。
        private void RequestStopSweep()
        {
            try { sweepCts?.Cancel(); } catch { }

            if (sweepButton != null) sweepButton.Text = "Stopping...";
            SetStatus(StatusLevel.Warn, "Stopping... DC Load will be turned off.");
        }

        // ===== DC Load 命令族 =====
        // 這一段的作法與命令內容取自 Data.cs（ProbeLoad / LoadCommandSets）。
        // Chroma 兩個負載家族的命令完全不同，不能共用：
        //
        //   63xxx  電子負載        CURR:STAT:L1 <A>   /  LOAD ON|OFF
        //   62000D 雙向電源        LOAD:CURRent <A>   /  CONFigure:OUTPut ON|OFF，
        //                          且拉載前必須先 SYSTem:MODE LOAD 把機器切到負載模式。
        //
        // 關鍵在於：送出機器不認識的命令時，Chroma 只會把錯誤丟進佇列、不做任何動作。
        // 沒有例外、沒有逾時、面板上也毫無異狀 —— 外觀就是「按了 RMS Value，
        // 負載卻完全沒有反應」。本檔原本把 63xxx 的寫法寫死，接上另一族的機器就是這個下場，
        // 而且因為從來沒人讀過錯誤佇列，錯了幾百次也沒有任何跡象。
        //
        // 因此命令族不能用猜的，也不能靠型號硬編碼：連線後對候選族送出它的電流查詢，
        // 機器答得出數值、且錯誤佇列乾淨，才認定是這一族。型號只決定嘗試順序。
        private class DcLoadCommandSet
        {
            public string Name;
            /// <summary>電流設定命令的前綴，後面接空白與安培值。</summary>
            public string SetCurrent;
            /// <summary>探測用：能正常回應此查詢，代表機器屬於這一族。</summary>
            public string QueryCurrent;
            public string OutputOn;
            public string OutputOff;
            /// <summary>拉載前要先送的模式切換命令；null 代表這一族不需要切模式。</summary>
            public string EnterLoadMode;
            /// <summary>型號前綴符合時優先試這一族，避免對不支援的機器送查詢白等一次逾時。</summary>
            public string[] ModelPrefixes;
        }

        private static readonly DcLoadCommandSet[] DcLoadCommandSets =
        {
            new DcLoadCommandSet
            {
                Name          = "Chroma 63xxx 電子負載",
                SetCurrent    = "CURR:STAT:L1",
                QueryCurrent  = "CURR:STAT:L1?",
                OutputOn      = "LOAD ON",
                OutputOff     = "LOAD OFF",
                EnterLoadMode = null,
                ModelPrefixes = new[] { "63" },
            },
            new DcLoadCommandSet
            {
                Name          = "Chroma 62000D 雙向電源（Load 模式）",
                SetCurrent    = "LOAD:CURRent",
                QueryCurrent  = "LOAD:CURRent?",
                OutputOn      = "CONFigure:OUTPut ON",
                OutputOff     = "CONFigure:OUTPut OFF",
                EnterLoadMode = "SYSTem:MODE LOAD",
                ModelPrefixes = new[] { "62" },
            },
        };

        // 連線後探測出來的命令族，Disconnect 時清掉。
        private DcLoadCommandSet dcLoadCommands;

        // 命令一律補上 LF 結尾（本檔原本每個呼叫點各自手寫 "\n"，漏掉一次就是靜默失敗）。
        private static void VisaWrite(MessageBasedSession s, string cmd)
        {
            s.RawIO.Write(cmd.EndsWith("\n") ? cmd : cmd + "\n");
        }

        private static string VisaQuery(MessageBasedSession s, string cmd)
        {
            VisaWrite(s, cmd);
            return s.RawIO.ReadString().Trim();
        }

        // 查詢 SCPI 錯誤佇列，取回非零錯誤的原文；佇列乾淨或讀不到則回 null。
        // Chroma 收到不認識的命令不會有任何外顯反應，只會在這裡留下記錄。
        private static string DcLoadErrorText(MessageBasedSession s)
        {
            try
            {
                string e = VisaQuery(s, "SYSTem:ERRor?");
                if (string.IsNullOrEmpty(e)) return null;

                double code;
                string first = e.Split(',')[0].Trim();
                if (double.TryParse(first, NumberStyles.Float, CultureInfo.InvariantCulture, out code)
                    && Math.Abs(code) > 0.5)
                    return e;

                return null;
            }
            catch (Exception ex)
            {
                // 讀不到錯誤佇列不該讓量測跑不起來，只留 log
                Console.WriteLine("DC Load SYSTem:ERRor? failed: " + ex.Message);
                return null;
            }
        }

        // 送出一個查詢並判斷機器是否真的屬於這一族：要能解析出數字，且錯誤佇列乾淨。
        // 逾時代表機器不認識這條命令，輸出緩衝可能殘留半筆資料，因此清一次介面再繼續，
        // 否則下一族的查詢會讀到上一筆的殘骸而誤判。
        private bool DcLoadAnswers(MessageBasedSession session, string query)
        {
            int oldTimeout = session.TimeoutMilliseconds;
            try
            {
                session.TimeoutMilliseconds = 2000;
                VisaWrite(session, "*CLS");

                string answer = VisaQuery(session, query);
                double v;
                if (!double.TryParse(answer, NumberStyles.Float, CultureInfo.InvariantCulture, out v))
                    return false;

                return DcLoadErrorText(session) == null;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"DC Load probe {query} failed: {ex.Message}");
                try { session.Clear(); } catch { }
                return false;
            }
            finally
            {
                try { session.TimeoutMilliseconds = oldTimeout; } catch { }
            }
        }

        // 探測命令族。已經探測過就直接沿用，不必每次掃描都重來一次。
        private DcLoadCommandSet EnsureDcLoadCommands()
        {
            if (dcLoadCommands != null) return dcLoadCommands;

            MessageBasedSession session = RequireDcLoadSession();
            if (session == null) return null;

            string model = InstrModel(SafeIdn(session));
            var ordered = DcLoadCommandSets
                .OrderByDescending(cs => MatchesPrefix(model, cs.ModelPrefixes))
                .ToList();

            foreach (var cs in ordered)
            {
                if (DcLoadAnswers(session, cs.QueryCurrent))
                {
                    dcLoadCommands = cs;
                    Console.WriteLine($"DC Load command set : {cs.Name}  ({cs.SetCurrent} / {cs.OutputOn})");
                    return cs;
                }
                Console.WriteLine($"DC Load probe {cs.QueryCurrent,-16} -> not supported");
            }

            // 查詢全部失敗時仍要給一組命令，否則整個掃描無從執行。
            // 依型號推定，推不出來就用清單第一族（63xxx，本工具原本的預設）。
            dcLoadCommands = ordered[0];
            Console.WriteLine("DC Load command probe failed, assuming by model : " + dcLoadCommands.Name);
            return dcLoadCommands;
        }

        // 組出「設定拉載電流」的命令。小數點一律用 InvariantCulture，
        // 免得換到逗號當小數點的地區設定就送出 "CURR:STAT:L1 3,60" 這種機器看不懂的字串。
        private string DcLoadSetCurrentCommand(double amps)
        {
            var cs = dcLoadCommands ?? DcLoadCommandSets[0];
            return cs.SetCurrent + " " + amps.ToString("0.##", CultureInfo.InvariantCulture);
        }

        // 掃描開頭開負載：先切模式（需要的機種）、電流歸零，最後才開輸出 ——
        // 避免上一輪殘留的電流設定值一開就整個灌下去。
        // 送完回頭讀一次錯誤佇列：命令被機器吃掉的話，這是唯一看得出來的地方。
        private bool TurnOnDcLoad()
        {
            MessageBasedSession session = RequireDcLoadSession();
            if (session == null) return false;

            DcLoadCommandSet cs = EnsureDcLoadCommands();
            if (cs == null) return false;

            // 先清掉錯誤佇列裡上一輪的殘留，等一下問到的才是這次開負載的結果
            VisaWrite(session, "*CLS");

            // 62000D 這類雙向電源開機時可能停在 Source 模式，不先切到 Load 模式，
            // 後面的電流命令會被機器忽略。63xxx 電子負載沒有這道手續。
            if (cs.EnterLoadMode != null)
            {
                VisaWrite(session, cs.EnterLoadMode);
                Console.WriteLine("DC Load <- " + cs.EnterLoadMode);
            }

            VisaWrite(session, DcLoadSetCurrentCommand(0));
            VisaWrite(session, cs.OutputOn);
            Console.WriteLine("DC Load <- " + cs.OutputOn);

            string err = DcLoadErrorText(session);
            if (err != null)
            {
                SetStatus(StatusLevel.Error,
                          $"DC Load did not turn on - measurement aborted. SYSTem:ERRor? = {err}",
                          $"    Command set : {cs.Name}\r\n" +
                          $"    Sent        : {cs.OutputOn}\r\n" +
                          $"    DC Load     : {DC_Load63202A_Address}");
                return false;
            }

            Console.WriteLine("DC Load is ON.");
            SetStatus(StatusLevel.Info, "DC Load ON.");
            return true;
        }

        // 收尾關負載：正常結束、例外與使用者中斷都會走到這裡，所以自己吞掉例外，
        // 不讓收尾動作再丟出第二個錯誤蓋掉原本的失敗原因。
        private void TurnOffDcLoad()
        {
            try
            {
                if (dcLoadSession == null) return;

                var cs = dcLoadCommands ?? DcLoadCommandSets[0];
                VisaWrite(dcLoadSession, DcLoadSetCurrentCommand(0));
                VisaWrite(dcLoadSession, cs.OutputOff);
                Console.WriteLine("DC Load <- " + cs.OutputOff);
            }
            catch (Exception ex)
            {
                Console.WriteLine("TurnOffDcLoad: " + ex.Message);
            }
        }

