        // 視窗關閉中：讓還在進行的 DataReceived 回呼立刻收手，不要再去 Invoke UI。
        private volatile bool shuttingDown = false;

        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            // 關閉通訊埠有兩個互相衝突的陷阱，必須同時避開：
            //
            //  a) 直接在 UI 執行緒呼叫 Close()：Close() 會等 DataReceived 回呼結束，
            //     而回呼裡的 Invoke() 又在等 UI 執行緒 -> 互鎖。
            //  b) 用 Task.Run() 射後不理：表單一關行程就結束，執行緒集區是背景執行緒
            //     會被直接終止，Close() 常常還沒跑完，驅動層 handle 沒正常釋放，
            //     下次開啟就會「拒絕存取通訊埠」，得拔插 USB 才能恢復。
            //
            // 解法：丟到背景執行緒關閉(避開 a)，但一定要等它做完(避開 b)；等待期間持續
            // 泵送視窗訊息，卡在 Invoke() 的回呼才能完成，Close() 才回得來。
            shuttingDown = true;
            try { timer?.Stop(); } catch { }
            try { DisconnectVisa(quiet: true); } catch { }
            try { serialPort1.DataReceived -= new SerialDataReceivedEventHandler(DataReceivedHandler); } catch { }

            if (serialPort1 != null && serialPort1.IsOpen)
            {
                var sp = serialPort1;
                var done = new ManualResetEventSlim(false);

                var closer = new Thread(() =>
                {
                    try { sp.DiscardInBuffer(); } catch { }
                    try { sp.Close(); } catch { }
                    try { sp.Dispose(); } catch { }
                    done.Set();
                });
                closer.IsBackground = true;
                closer.Start();

                // 最多等 5 秒；真的關不掉也只能放行，讓行程結束比整個卡死好。
                var sw = System.Diagnostics.Stopwatch.StartNew();
                while (!done.IsSet && sw.ElapsedMilliseconds < 5000)
                {
                    Application.DoEvents();   // 讓卡在 Invoke() 的回呼跑完
                    Thread.Sleep(10);
                }

                if (!done.IsSet)
                    Console.WriteLine("Warning: serial port did not close within 5s.");
            }
        }

        private void DataReceivedHandler(object sender, SerialDataReceivedEventArgs e)
        {
            // 關閉流程已啟動就不要再碰 UI，否則 Invoke() 會與 Close() 互鎖
            if (shuttingDown) return;

            SerialPort sp = (SerialPort)sender;
            int bytesToRead = sp.BytesToRead;
            byte[] buffer = new byte[bytesToRead];
            sp.Read(buffer, 0, bytesToRead);

            // Add the received data to the global buffer
            receiveBuffer.AddRange(buffer);

            // Check if there is enough data to process
            ProcessBuffer();
        }
        // 封包格式：0x49, LEN, payload(LEN bytes), SumZero  ->  總長 = LEN + 3
        //   auto report 19 = 0x49 0x10 ... / cali 15 = 0x49 0x0C ... / 4 = 0x49 0x01 ... / 7 = 0x49 0x04 ...
        private const byte FrameHeader = 0x49;

        // 收包狀態全部歸零：緩衝區、預期封包長度、正在等待回填的目標欄位。
        // 開埠與關埠都要呼叫 —— 上一次連線殘留的半截封包若留著，會跟新資料黏成一串，
        // 開頭就不是 0x49，之後每一包都跟著錯位。
        private void ResetReceiveState()
        {
            receiveBuffer.Clear();
            expectedLength = 19;    // 回到 auto-report 模式
            targetTextBox = "";
        }

        // 把緩衝區前端的雜訊丟掉，直到開頭是一個「框頭 + 長度」都對得上的封包。
        // 插拔序列埠時 MCU 仍持續在送，開埠後收到的第一筆通常是從封包中間開始；
        // 少了這道對齊，PC 會一直用錯的位移去切封包，資料永遠認不出來。
        // 回傳 true 表示開頭已對齊（不保證已經收滿一整包）。
        private bool ResyncToFrameHeader()
        {
            byte wantLen = (byte)(expectedLength - 3);   // 長度欄位 = 總長 - 框頭 - 長度 - 檢查碼
            int dropped = 0;
            bool aligned = false;

            while (receiveBuffer.Count > 0)
            {
                if (receiveBuffer[0] == FrameHeader)
                {
                    // 只認 0x49 不夠：payload 裡剛好出現的 0x49 會被誤判成框頭，
                    // 所以長度欄位也要符合目前正在等的封包。
                    if (receiveBuffer.Count < 2) break;      // 還看不出來，等下一筆進來再判斷
                    if (receiveBuffer[1] == wantLen) { aligned = true; break; }
                }

                receiveBuffer.RemoveAt(0);   // 對不上就往前挪一個 byte 繼續找
                dropped++;
            }

            if (dropped > 0)
                Console.WriteLine($"Resync : dropped {dropped} unaligned byte(s), waiting for 49 {wantLen:X2}");

            return aligned;
        }

        // 檢查碼驗證：整包（含檢查碼）相加應為 0。
        // 目前只記錄不丟包 —— 萬一韌體回傳的封包沒有補 SumZero，丟包會讓功能整個失效。
        private static bool IsChecksumValid(byte[] frame)
        {
            byte sum = 0;
            foreach (byte b in frame) sum += b;
            return sum == 0;
        }

        private void ProcessBuffer()
        {
            // Process the 19-byte auto-report data
            while (true)
            {
                // 每一輪都先對齊框頭，再看資料夠不夠一整包
                if (!ResyncToFrameHeader()) return;
                if (receiveBuffer.Count < expectedLength) return;

                if (expectedLength == 19)
                {
                    // Process the 19-byte auto-report data
                    byte[] autoReportData = receiveBuffer.GetRange(0, 19).ToArray();
                    receiveBuffer.RemoveRange(0, 19);   // Remove the processed data

                    // 檢查碼對不上多半代表這包仍未對齊或線上有雜訊。這裡只記錄不丟包，
                    // 若確認韌體每包都補了 SumZero，可以改成直接丟棄這一包。
                    if (!IsChecksumValid(autoReportData))
                        Console.WriteLine("Warning : auto-report checksum mismatch.");

                    ProcessAutoReport(autoReportData);
                }
                else if (expectedLength == 15)
                {
                    // Process the 19-byte auto-report data
                    byte[] autoReportData = receiveBuffer.GetRange(0, 15).ToArray();
                    //receiveBuffer.RemoveRange(0, 15);   // Remove the processed data
                    receiveBuffer.Clear();  // Clear the entire buffer and wait for the next valid data frame

                    // Update the corresponding control based on targetTextBox
                    ProcessCaliData(autoReportData);

                    // Resume 19-byte reception mode
                    //expectedLength = 19;

                    // Send start command
                    //byte[] myBytes14 = { 0x49, 0x02, 0x81, 0x7F, 0xB5 };
                    //serialPort1.Write(myBytes14, 0, myBytes14.Length); // Write out 6 bytes of data
                    //Thread.Sleep(100);  // Delay 100ms
                }
                else if (expectedLength == 4)
                {
                    // Process 4 bytes of data
                    byte[] commandResponse = receiveBuffer.GetRange(0, 4).ToArray();
                    receiveBuffer.RemoveRange(0, 4);   // Remove the processed data

                    // Update the corresponding control based on the targetTextBox
                    ProcessDataForTextBox(commandResponse, targetTextBox);

                    // Resume 19-byte reception mode
                    expectedLength = 19;

                    // Send start command
                    // 本方法由 DataReceived 的背景執行緒呼叫。若使用者剛好在回呼進行中
                    // 按下 Close，對已關閉的埠寫入會拋例外，而背景執行緒的未處理例外
                    // 會直接讓程式崩潰，所以這裡必須檢查。
                    if (serialPort1.IsOpen)
                    {
                        byte[] myBytes14 = { 0x49, 0x02, 0x81, 0x7F, 0xB5 };
                        serialPort1.Write(myBytes14, 0, myBytes14.Length); // Write out 6 bytes of data
                        Thread.Sleep(100);  // Delay 100ms
                    }
                }
                else if (expectedLength == 7)
                {
                    // Process 4 bytes of data
                    byte[] commandResponse = receiveBuffer.GetRange(0, 7).ToArray();
                    receiveBuffer.RemoveRange(0, 7);   // Remove the processed data

                    // Update the corresponding control based on the targetTextBox
                    ProcessDataForTextBox(commandResponse, targetTextBox);

                    // Resume 19-byte reception mode
                    expectedLength = 19;

                    // Send start command
                    // 本方法由 DataReceived 的背景執行緒呼叫。若使用者剛好在回呼進行中
                    // 按下 Close，對已關閉的埠寫入會拋例外，而背景執行緒的未處理例外
                    // 會直接讓程式崩潰，所以這裡必須檢查。
                    if (serialPort1.IsOpen)
                    {
                        byte[] myBytes14 = { 0x49, 0x02, 0x81, 0x7F, 0xB5 };
                        serialPort1.Write(myBytes14, 0, myBytes14.Length); // Write out 6 bytes of data
                        Thread.Sleep(100);  // Delay 100ms
                    }
                }
                else
                {
                    // 防呆：expectedLength 若被設成未知值，上面沒有任何分支會消耗資料，
                    // while (true) 會空轉卡死執行緒。直接重置回 auto-report 模式。
                    Console.WriteLine($"Unexpected expectedLength = {expectedLength}, reset to 19.");
                    ResetReceiveState();
                    return;
                }
            }
        }

