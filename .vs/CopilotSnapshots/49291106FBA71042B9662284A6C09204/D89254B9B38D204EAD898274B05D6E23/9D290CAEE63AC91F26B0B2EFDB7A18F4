        private class VisaDevice
        {
            public string Address { get; }
            public string DisplayName { get; }
            public VisaDevice(string address, string displayName = null)
            {
                Address = address;
                DisplayName = displayName ?? address;
            }
            public override string ToString() => DisplayName;
        }

        private string QueryIdn(NationalInstruments.Visa.ResourceManager rm, string resource)
        {
            try
            {
                using (var session = (MessageBasedSession)rm.Open(resource))
                {
                    session.TimeoutMilliseconds = 2000;
                    session.RawIO.Write("*IDN?\n");
                    return session.RawIO.ReadString().Trim();
                }
            }
            catch { return null; }
        }

        private void RestoreComboSelection(ComboBox cbb, string address)
        {
            if (string.IsNullOrEmpty(address)) { if (cbb.Items.Count > 0) cbb.SelectedIndex = 0; return; }
            var match = cbb.Items.Cast<VisaDevice>().FirstOrDefault(d => d.Address == address);
            if (match != null) cbb.SelectedItem = match;
            else if (cbb.Items.Count > 0) cbb.SelectedIndex = 0;
        }

        // 掃描後的選取：優先選中「這次實際掃到」的裝置，而不是死掉的預設項。
        //  1. 上次選的若本次仍有掃到 → 保留（尊重使用者手動選擇）
        //  2. 否則選第一個實際掃到的裝置
        //  3. 都沒掃到 → 退回舊行為（RestoreComboSelection：上次選擇或第一項）
        private void SelectPreferFound(ComboBox cbb, string prevAddr, List<string> foundAddrs)
        {
            var items = cbb.Items.Cast<VisaDevice>().ToList();
            if (!string.IsNullOrEmpty(prevAddr) && foundAddrs.Contains(prevAddr))
            {
                var keep = items.FirstOrDefault(d => d.Address == prevAddr);
                if (keep != null) { cbb.SelectedItem = keep; return; }
            }
            foreach (var addr in foundAddrs)
            {
                var m = items.FirstOrDefault(d => d.Address == addr);
                if (m != null) { cbb.SelectedItem = m; return; }
            }
            RestoreComboSelection(cbb, prevAddr);
        }

        // 加入裝置到下拉；若已存在同位址，就「升級」成帶 *IDN? 友善名稱的那筆，
        // 避免掃到實體儀器卻只顯示原始位址、看起來像沒找到。
        private void AddOrUpgradeDevice(ComboBox cbb, VisaDevice device)
        {
            for (int i = 0; i < cbb.Items.Count; i++)
            {
                if (cbb.Items[i] is VisaDevice d && d.Address == device.Address)
                {
                    if (device.DisplayName != device.Address) cbb.Items[i] = device;
                    return;
                }
            }
            cbb.Items.Add(device);
        }

        // ===== 儀器型號前綴清單：未來新增機種只要在這裡各加一行（大寫）=====
        //   例：新負載 64xxx → 在 DcLoadModelPrefixes 加 "64"
        //       新功率計 67xxx → 在 PowerMeterModelPrefixes 加 "67"
        //   認不出的型號會走 fallback（兩邊下拉都列），不會遺失，人工仍可挑選。
        private static readonly string[] DcLoadModelPrefixes     = { "63" };            // Chroma 電子負載家族
        private static readonly string[] PowerMeterModelPrefixes = { "66", "WT" };      // Chroma 功率計 / Yokogawa WT
        // 已知 USB PID（IDN 讀不到、或型號前綴沒命中時的備援，無條件檢查）
        private static readonly string[] DcLoadUsbPids           = { "0X0879", "0X0884" };   // Chroma 632xx 負載（0884 為實機量到）
        private static readonly string[] PowerMeterUsbPids       = { "0X0835", "0X087D" };   // Chroma 662xx 功率計（087D = 66205 實機）

        // 從 *IDN? 取出「型號」欄位（第 2 個逗號欄位）。
        // Chroma 例: "Chroma ATE,63202,SN,VER" → "63202"；Yokogawa 例: "YOKOGAWA,WT310,..." → "WT310"
        // 只比對這個欄位、不對整串做子字串搜尋，避免序號裡剛好有 63/66 而誤判。
        private string InstrModel(string idn)
        {
            if (string.IsNullOrEmpty(idn)) return "";
            var parts = idn.Split(',');
            return parts.Length >= 2 ? parts[1].Trim().ToUpperInvariant() : "";
        }

        private static bool MatchesPrefix(string model, string[] prefixes)
        {
            if (string.IsNullOrEmpty(model)) return false;
            foreach (var p in prefixes) if (model.StartsWith(p)) return true;
            return false;
        }

        private static bool ResourceHasAnyPid(string resource, string[] pids)
        {
            string r = (resource ?? "").ToUpperInvariant();
            foreach (var p in pids) if (r.Contains(p)) return true;
            return false;
        }

        // 電子負載：型號前綴命中 DcLoadModelPrefixes，或 USB PID 命中 DcLoadUsbPids。
        private bool IsDcLoadDevice(string resource, string idn)
        {
            if (MatchesPrefix(InstrModel(idn), DcLoadModelPrefixes)) return true;
            if (ResourceHasAnyPid(resource, DcLoadUsbPids)) return true;
            return false;
        }

        // 功率計：型號前綴命中 PowerMeterModelPrefixes、Yokogawa、或 USB PID 命中 PowerMeterUsbPids。
        private bool IsPowerMeterDevice(string resource, string idn)
        {
            if (MatchesPrefix(InstrModel(idn), PowerMeterModelPrefixes)) return true;
            if ((idn ?? "").ToUpperInvariant().Contains("YOKOGAWA")) return true;
            if (ResourceHasAnyPid(resource, PowerMeterUsbPids)) return true;
            return false;
        }

        // 掃描 USB VISA 儀器，依型別分別填入 DC Load / Power Meter 兩個下拉。
        private void scanVisaDevices()
        {
            try
            {
                // 重新掃描會清空並重填下拉，先斷線避免 session 與選取項對不起來
                if (VisaConnected) DisconnectVisa(quiet: true);
                UpdateVisaUi();

                string currentDcLoad = (dc_load_cbb.SelectedItem as VisaDevice)?.Address ?? dc_load_cbb.Text;
                string currentPowerMeter = (power_meter_cbb.SelectedItem as VisaDevice)?.Address ?? power_meter_cbb.Text;

                dc_load_cbb.Items.Clear();
                power_meter_cbb.Items.Clear();

                // 這次掃描「實際列舉到」的裝置位址（用來優先選中真的有接的儀器）
                var foundDcLoads = new List<string>();
                var foundPowerMeters = new List<string>();
                try
                {
                    using (var rm = new NationalInstruments.Visa.ResourceManager())
                    {
                        var resources = rm.Find("USB?*INSTR");
                        foreach (string resource in resources)
                        {
                            string idn = QueryIdn(rm, resource);
                            string displayName = resource;
                            if (!string.IsNullOrEmpty(idn))
                            {
                                var parts = idn.Split(',');
                                if (parts.Length >= 2)
                                    displayName = $"{parts[0].Trim()} {parts[1].Trim()} ({resource})";
                            }
                            var device = new VisaDevice(resource, displayName);

                            // 依 USB PID / IDN 型號判斷裝置型別，只把裝置放進對應的下拉：
                            //  - Chroma DC load  → PID 0x0879 → 只加到 dc_load_cbb
                            //  - 功率計(Chroma 66xxx PID 0x0835 / Yokogawa) → 只加到 power_meter_cbb
                            //  - 無法判別 → 兩邊都加，讓使用者自選
                            bool isDcLoad = IsDcLoadDevice(resource, idn);
                            bool isPowerMeter = IsPowerMeterDevice(resource, idn);
                            if (!isDcLoad && !isPowerMeter) { isDcLoad = true; isPowerMeter = true; }

                            if (isDcLoad) { AddOrUpgradeDevice(dc_load_cbb, device); foundDcLoads.Add(resource); }
                            if (isPowerMeter) { AddOrUpgradeDevice(power_meter_cbb, device); foundPowerMeters.Add(resource); }
                        }
                    }
                    SetStatus(StatusLevel.Info, "VISA scan complete.");
                }
                catch (Exception ex) when (
                    ex is DllNotFoundException ||
                    ex is TypeInitializationException ||
                    ex is BadImageFormatException)
                {
                    SetStatus(StatusLevel.Warn, "NI-VISA driver not installed - USB scan skipped.");
                    Console.WriteLine("NI-VISA not available: " + ex.Message);
                }
                catch (Exception ex)
                {
                    SetStatus(StatusLevel.Warn, "No USB VISA instruments found.");
                    Console.WriteLine("VISA scan: " + ex.Message);
                }

                SelectPreferFound(dc_load_cbb, currentDcLoad, foundDcLoads);
                SelectPreferFound(power_meter_cbb, currentPowerMeter, foundPowerMeters);
            }
            catch (Exception ex)
            {
                SetStatus(StatusLevel.Error, "VISA scan failed.");
                Console.WriteLine("scanVisaDevices error: " + ex.Message);
            }
        }

