        // ===== 訊息輸出：一律走狀態列，不跳視窗 =====
        // 量測進行中跳 MessageBox 會擋住畫面，而且非得有人按 OK 才會繼續 ——
        // 現場一邊盯著儀器一邊按確認很干擾，長時間掃描更可能整晚卡在一個對話框上沒人發現。
        // 改成：狀態列顯示壓成一行的摘要（依嚴重度上色），完整內容寫進 Output 視窗，
        // 多行細節一個字都不會少。
        private enum StatusLevel { Info, Warn, Error }

        private void SetStatus(StatusLevel level, string summary, string detail = null)
        {
            // 序列埠的 DataReceived 是在背景執行緒跑的，從那裡碰控制項會丟
            // InvalidOperationException。彈跳視窗沒有這個限制，改成狀態列就有了。
            if (statusStrip1.InvokeRequired)
            {
                statusStrip1.BeginInvoke((Action)(() => SetStatus(level, summary, detail)));
                return;
            }

            StatusLabel2.Text = FlattenForStatusBar(summary);
            StatusLabel2.ForeColor =
                level == StatusLevel.Error ? Color.Firebrick :
                level == StatusLevel.Warn  ? Color.DarkOrange :
                                             SystemColors.ControlText;

            // 狀態列只有一行，長訊息會被視窗寬度切掉。滑鼠停在上面可以看到完整內容
            // （含多行明細）—— 這是取代對話框之後，細節唯一還看得到的地方。
            statusStrip1.ShowItemToolTips = true;
            StatusLabel2.ToolTipText =
                string.IsNullOrEmpty(detail) ? summary : summary + "\r\n" + detail;

            // 掃描迴圈長時間佔著 UI 執行緒（VISA 讀取是阻塞的），
            // 不主動重繪的話狀態列會停在舊字樣，看起來就像程式沒反應。
            try { statusStrip1.Refresh(); } catch { }

            Console.WriteLine($"[{level}] {summary}");
            if (!string.IsNullOrEmpty(detail)) Console.WriteLine(detail);
        }

        // 狀態列只有一行：換行壓成 " | "，前後空白去掉，空行丟掉。
        private static string FlattenForStatusBar(string text)
        {
            if (string.IsNullOrEmpty(text)) return "";

            return string.Join(" | ", text.Replace("\r\n", "\n")
                                          .Replace('\r', '\n')
                                          .Split('\n')
                                          .Select(p => p.Trim())
                                          .Where(p => p.Length > 0));
        }

        // 取用常駐 session；未連線就提示並回傳 null，呼叫端直接 return。
        private MessageBasedSession RequireDcLoadSession()
        {
            if (dcLoadSession == null) ShowVisaNotConnected("DC Load");
            return dcLoadSession;
        }

        private MessageBasedSession RequirePowerMeterSession()
        {
            if (powerMeterSession == null) ShowVisaNotConnected("Power Meter");
            return powerMeterSession;
        }

        // ===== 功率計讀值：依 *IDN? 廠商切換命令集 =====
        // Chroma 662xx 吃 MEAS:xxx?；Yokogawa WT310E 不支援 MEAS 這組命令（送了不回應，
        // 只會等到逾時），必須先用 :NUMERIC:NORMAL:ITEM1 指定量測項目再讀 VALUE?。
        // 移植自 v1_03_WT310E1 的 ReadVIP/QueryYokogawa。
        private enum MeterType { Unknown, Chroma, Yokogawa }

        // Connect 時由 ReportVisaIdentity 依 IDN 設定，斷線時歸零
        private MeterType powerMeterType = MeterType.Unknown;

        private static MeterType DetectMeterType(string idn)
        {
            string u = (idn ?? "").ToUpperInvariant();
            if (u.Contains("YOKOGAWA")) return MeterType.Yokogawa;
            if (u.Contains("CHROMA")) return MeterType.Chroma;
            return MeterType.Unknown;
        }

        // 讀取功率計的 RMS 電壓、電流、實功率，回傳原始字串（各自以 '\n' 結尾），
        // 呼叫端照舊自行顯示與解析 —— Chroma 路徑送的命令與舊流程完全相同。
        // 失敗時 VisaException 往外拋，由呼叫端的 catch 顯示。
        private void ReadPowerMeterRaw(MessageBasedSession session,
                                       out string voltage, out string current, out string power)
        {
            // Connect 時 *IDN? 沒回應（開機初期常見）就在第一次讀值時補問
            if (powerMeterType == MeterType.Unknown)
            {
                session.RawIO.Write("*IDN?\n");
                string idn = session.RawIO.ReadString().Trim();
                powerMeterType = DetectMeterType(idn);
                Console.WriteLine($"Power Meter IDN: {idn} -> {powerMeterType}");
            }

            if (powerMeterType == MeterType.Yokogawa)
            {
                // 與 v1_03_WT310E1 實機驗證過的項目名稱相同
                voltage = QueryYokogawa(session, "URMS");
                current = QueryYokogawa(session, "IRMS");
                power   = QueryYokogawa(session, "P");
                return;
            }

            // Chroma（以及認不出廠牌時）維持原本的命令
            session.RawIO.Write("MEAS:VOLT:RMS?\n");
            voltage = session.RawIO.ReadString();
            session.RawIO.Write("MEAS:CURR:RMS?\n");
            current = session.RawIO.ReadString();
            session.RawIO.Write("MEAS:POW:REAL?\n");
            power = session.RawIO.ReadString();
        }

        // Yokogawa WT 系列：先把 ITEM1 指到要的量測功能（element 1），再讀 ITEM1 的值。
        // 儀器回傳科學記號（如 "230.12E+00"），這裡轉成一般小數再交出去，
        // 讓畫面顯示與 Chroma 一致（如 "230.12"）。
        private static string QueryYokogawa(MessageBasedSession session, string function)
        {
            session.RawIO.Write($":NUMERIC:NORMAL:ITEM1 {function},1\n");
            session.RawIO.Write(":NUMERIC:NORMAL:VALUE? 1\n");
            string resp = session.RawIO.ReadString().Trim();

            // 超量程 / 無資料時 WT 回 9.91E+37（或 NAN、INF），顯示成 "OL"。
            // "OL" 解析不出數字 → 呼叫端拿到 0，誤差率那段會因為 != 0 判斷而跳過。
            if (!double.TryParse(resp, NumberStyles.Float, CultureInfo.InvariantCulture, out double v)
                || double.IsNaN(v) || double.IsInfinity(v) || Math.Abs(v) >= 1e30)
            {
                Console.WriteLine($"Yokogawa {function}: over-range / no data ({resp})");
                return "OL\n";
            }

            // 最多 6 位小數、去尾零、永不使用指數。電流 mA 等級（如 0.012345 A）也保得住有效位數。
            return v.ToString("0.######", CultureInfo.InvariantCulture) + "\n";
        }

        private void ShowVisaNotConnected(string what)
        {
            SetStatus(StatusLevel.Error, $"{what} is not connected - select the instrument and press \"Connect\" first.");
        }

        // VISA 操作失敗時把真正的錯誤攤開。原本 5 個 catch 一律只顯示 "Confirm connection."，
        // 連線中斷(VI_ERROR_CONN_LOST)、命令逾時(VI_ERROR_TMO)、資源被佔用(VI_ERROR_RSRC_BUSY)
        // 現場全都長一樣，完全無從判斷是哪一台、哪一種失敗。
        // 一併印出目前選到的兩個位址 —— 兩台若被選成同一個位址(共用 session)也能立刻看出來。
        private void ShowVisaError(VisaException ex, string what)
        {
            string detail = $"{ex.GetType().Name}: {ex.Message}";

            SetStatus(StatusLevel.Error,
                      $"[{what}] VISA operation failed - {detail}",
                      $"    DC Load     : {DC_Load63202A_Address}\r\n" +
                      $"    Power Meter : {PowerMeter66202_Address}");
        }



