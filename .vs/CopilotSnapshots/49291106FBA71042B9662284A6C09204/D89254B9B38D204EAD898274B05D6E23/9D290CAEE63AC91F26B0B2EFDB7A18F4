        #region Compensation parameters (see NADC24_CMD.h)

        // 這些常數必須與韌體的 NADC24_CMD.h 一致。
        // 注意 0xB0~0xBF 保留給 WT310E1 四點校正韌體，本工具不得使用。
        private const byte CMD_WRITE_LL_I_COMP      = 0xA1;
        private const byte CMD_WRITE_HL_P_COMP      = 0xA5;
        private const byte CMD_WRITE_DC_P_COMP      = 0xA7;
        private const byte CMD_WRITE_DC_I_COMP      = 0xA9;
        private const byte CMD_WRITE_LL_R_VDROP     = 0xAB;
        private const byte CMD_WRITE_HL_R_VDROP     = 0xAD;
        private const byte CMD_WRITE_DC_R_VDROP     = 0xAF;
        private const byte CMD_WRITE_HL_I_LIGHT_P1  = 0xC1;
        private const byte CMD_WRITE_HL_I_LIGHT_P2  = 0xC3;
        private const byte CMD_WRITE_HL_I_LIGHT_P3  = 0xC5;
        private const byte CMD_WRITE_HL_I_LIGHT_P4  = 0xC7;
        private const byte CMD_WRITE_HL_I_LIGHT_P5  = 0xC9;
        private const byte CMD_SAVE_COMP_PARA       = 0xCB;

        // 50Hz 那一組（上面除了 DC_* 以外都是 60Hz 那一組）
        private const byte CMD_WRITE_LL_I_COMP_50HZ     = 0xD1;
        private const byte CMD_WRITE_HL_P_COMP_50HZ     = 0xD3;
        private const byte CMD_WRITE_LL_R_VDROP_50HZ    = 0xD5;
        private const byte CMD_WRITE_HL_R_VDROP_50HZ    = 0xD7;
        private const byte CMD_WRITE_HL_I_LIGHT_P1_50HZ = 0xD9;
        private const byte CMD_WRITE_HL_I_LIGHT_P2_50HZ = 0xDB;
        private const byte CMD_WRITE_HL_I_LIGHT_P3_50HZ = 0xDD;
        private const byte CMD_WRITE_HL_I_LIGHT_P4_50HZ = 0xDF;
        private const byte CMD_WRITE_HL_I_LIGHT_P5_50HZ = 0xE1;

        // READ 碼一律是對應 WRITE 碼減 1（偶數 READ / 奇數 WRITE）
        private static byte ReadCmdOf(byte writeCmd) => (byte)(writeCmd - 1);

        // 一個補償參數：命令碼 + 對應的輸入框 + 顯示名稱
        private struct CompParam
        {
            public readonly byte WriteCmd;
            public readonly TextBox Box;
            public readonly string Name;
            public CompParam(byte writeCmd, TextBox box, string name)
            {
                WriteCmd = writeCmd; Box = box; Name = name;
            }
        }

        // 送出所有「已填值」的補償參數，最後用 SAVE_COMP_PARA 一次寫入 Flash。
        // 空白欄位會跳過而不是送 0 —— 只跑了三種線別其中一種時，其他線別的
        // 參數應該保留韌體裡原本的值，不能被歸零蓋掉。
        private void send_comp_btn_Click(object sender, EventArgs e)
        {
            if (!serialPort1.IsOpen)
            {
                SetStatus(StatusLevel.Warn, "Send Compensation: serial port is not open.");
                return;
            }

            var sent = new List<string>();
            var skipped = new List<string>();
            var invalid = new List<string>();

            foreach (var p in CompParams())
            {
                string text = p.Box.Text.Trim();
                if (string.IsNullOrEmpty(text)) { skipped.Add(p.Name); continue; }

                if (!TryParseFloatFlexible(text, out float v))
                {
                    invalid.Add($"{p.Name} = \"{text}\"");
                    continue;
                }

                SendCompWrite(p.WriteCmd, text);
                sent.Add($"  0x{p.WriteCmd:X2}  {p.Name} = {v.ToString("G9", CultureInfo.InvariantCulture)}");
            }

            if (invalid.Count > 0)
            {
                SetStatus(StatusLevel.Error,
                          "Send Compensation: these fields are not valid numbers, nothing was saved - "
                          + string.Join(", ", invalid));
                return;
            }

            if (sent.Count == 0)
            {
                SetStatus(StatusLevel.Warn, "Send Compensation: no value to send - generate them first.");
                return;
            }

            // 每個 WRITE 只改 MCU 的 RAM，這一步才真正燒進 Flash（獨立頁，一次抹寫）
            SendCaliCmd(CMD_SAVE_COMP_PARA, 500);

            // 每個參數的位址與數值明細留在 Output 視窗，狀態列只放結果摘要。
            string detail = string.Join("\r\n", sent);
            if (skipped.Count > 0)
                detail += "\r\n  Skipped (empty, kept as-is in the MCU): " + string.Join(", ", skipped);

            string summary = $"Compensation saved to Flash - {sent.Count} value(s) sent";
            if (skipped.Count > 0) summary += $", {skipped.Count} skipped";

            SetStatus(StatusLevel.Info, summary + ".", detail);
        }

        // 同步請求/回應：暫時卸下 DataReceived，直接讀回應。
        // 這樣不必動到既有的 targetTextBox / expectedLength 非同步狀態機。
        private bool TryReadCompValue(byte writeCmd, out float value)
        {
            value = 0f;
            if (!serialPort1.IsOpen) return false;

            serialPort1.DataReceived -= new SerialDataReceivedEventHandler(DataReceivedHandler);
            int oldTimeout = serialPort1.ReadTimeout;
            try
            {
                serialPort1.DiscardInBuffer();
                receiveBuffer.Clear();

                byte cmd = ReadCmdOf(writeCmd);
                byte[] core = { 0x49, 0x01, cmd };
                byte[] frame = { 0x49, 0x01, cmd, new SumZeroCalculator().CalculateSumZero(core) };
                serialPort1.Write(frame, 0, frame.Length);

                // 回應為 7 bytes：{ 0x49, 0x04, B3, B2, B1, B0, SumZero }
                serialPort1.ReadTimeout = 1000;
                byte[] buf = new byte[7];
                int got = 0;
                while (got < buf.Length)
                {
                    int n = serialPort1.Read(buf, got, buf.Length - got);
                    if (n <= 0) break;
                    got += n;
                }

                if (got < buf.Length || buf[0] != 0x49 || buf[1] != 0x04) return false;

                uint bits = (uint)(buf[2] << 24 | buf[3] << 16 | buf[4] << 8 | buf[5]);
                value = BitConverter.ToSingle(BitConverter.GetBytes(bits), 0);
                return true;
            }
            catch (TimeoutException) { return false; }
            catch (Exception ex) { Console.WriteLine("TryReadCompValue: " + ex.Message); return false; }
            finally
            {
                try { serialPort1.ReadTimeout = oldTimeout; } catch { }
                serialPort1.DataReceived += new SerialDataReceivedEventHandler(DataReceivedHandler);
            }
        }

        // 把 MCU 目前生效的補償值讀回填入欄位，用來驗證存檔與重開機後是否一致。
        private void read_comp_btn_Click(object sender, EventArgs e)
        {
            if (!serialPort1.IsOpen)
            {
                SetStatus(StatusLevel.Warn, "Read Compensation: serial port is not open.");
                return;
            }

            var lines = new List<string>();
            var failed = new List<string>();

            foreach (var p in CompParams())
            {
                if (TryReadCompValue(p.WriteCmd, out float v))
                {
                    p.Box.Text = v.ToString("F6", CultureInfo.InvariantCulture);
                    lines.Add($"  0x{ReadCmdOf(p.WriteCmd):X2}  {p.Name} = {v.ToString("G9", CultureInfo.InvariantCulture)}");
                }
                else
                {
                    failed.Add($"  {p.Name}");
                }
            }

            // 讀回來的每一筆數值留在 Output 視窗，狀態列只放「讀到幾筆 / 共幾筆」。
            string detail = string.Join("\r\n", lines);
            if (failed.Count > 0)
                detail += "\r\n  No response for:" + string.Join(",", failed);

            string summary = $"Compensation read back - {lines.Count}/{CompParams().Count} value(s)";
            if (failed.Count > 0) summary += $", {failed.Count} no response";

            SetStatus(failed.Count > 0 ? StatusLevel.Warn : StatusLevel.Info, summary + ".", detail);
        }

