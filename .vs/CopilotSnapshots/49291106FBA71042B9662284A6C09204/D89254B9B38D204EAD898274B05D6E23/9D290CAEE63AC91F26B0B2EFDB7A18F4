        // ===== VISA 常駐連線 =====
        // 原本每個量測動作都自己 new ResourceManager() 再 Open()/Dispose() 一次，
        // 等於每按一顆按鈕就重連一次儀器，Scan 完也沒有明確的「已連線」狀態。
        // 改成：Scan 只負責列舉裝置，按下 Connect 才開啟常駐 session，
        // 按下 Disconnect 一次關閉所有連線。
        private NationalInstruments.Visa.ResourceManager visaRm;
        private MessageBasedSession dcLoadSession;
        private MessageBasedSession powerMeterSession;

        // DC Load 與 Power Meter 若指到同一個位址就共用同一個 session
        //（同一個 USB 資源開兩個 session 會被鎖住），Dispose 時也只能放一次。
        private bool visaSharedSession = false;

        private const int VisaTimeoutMs = 5000;

        private bool VisaConnected => visaRm != null;

        private void visa_connect_btn_Click(object sender, EventArgs e)
        {
            if (VisaConnected) DisconnectVisa();
            else ConnectVisa();
        }

        private void ConnectVisa()
        {
            string dcLoadAddr = DC_Load63202A_Address;
            string powerMeterAddr = PowerMeter66202_Address;

            if (string.IsNullOrEmpty(dcLoadAddr) && string.IsNullOrEmpty(powerMeterAddr))
            {
                SetStatus(StatusLevel.Error, "No VISA address selected - press \"Scan Devices\" first.");
                return;
            }

            string opening = null;      // 失敗時用來指出是哪一台開不起來
            try
            {
                visaRm = new NationalInstruments.Visa.ResourceManager();

                if (!string.IsNullOrEmpty(dcLoadAddr))
                {
                    opening = "DC Load";
                    dcLoadSession = OpenVisaSession(dcLoadAddr);
                }

                if (!string.IsNullOrEmpty(powerMeterAddr))
                {
                    opening = "Power Meter";
                    if (powerMeterAddr == dcLoadAddr)
                    {
                        powerMeterSession = dcLoadSession;
                        visaSharedSession = true;
                    }
                    else
                    {
                        powerMeterSession = OpenVisaSession(powerMeterAddr);
                    }
                }

                UpdateVisaUi();
                SetStatus(StatusLevel.Info, "VISA connected.");
                ReportVisaIdentity(dcLoadAddr, powerMeterAddr);

                // 連線當下就把負載的命令族探測完，結果印在 Output 視窗。
                // 這樣「這台被認成哪一族」現場立刻看得到，
                // 而不是等按下 RMS Value 跑完一整輪才發現負載從頭到尾沒有反應。
                if (dcLoadSession != null) EnsureDcLoadCommands();
            }
            catch (Exception ex)
            {
                // 開到一半失敗就全部收乾淨，不留半開狀態（下次 Connect 才不會撞到殘留 handle）
                DisconnectVisa(quiet: true);
                SetStatus(StatusLevel.Error, $"Cannot connect {opening} - {ex.Message}");
            }
        }

        // Connect 當下就對兩個 session 各問一次 *IDN?，理由有二：
        //  1. 立刻證明 USB 鏈路真的活著 —— 不必等到按下量測鈕才吃到 IOTimeoutException，
        //     那時候已經分不清是「一開始就沒通」還是「量測途中才斷」。
        //  2. 立刻抓出「兩個下拉選到同一台」—— scanVisaDevices 認不出型號時會把同一台
        //     同時塞進兩個下拉(見 IsDcLoadDevice/IsPowerMeterDevice 的 fallback)，
        //     ConnectVisa 又會讓兩者共用 session，結果 CURR:STAT:L1 被送到功率計上。
        private void ReportVisaIdentity(string dcLoadAddr, string powerMeterAddr)
        {
            string dcIdn = SafeIdn(dcLoadSession);
            string pmIdn = visaSharedSession ? dcIdn : SafeIdn(powerMeterSession);
            powerMeterType = DetectMeterType(pmIdn);

            Console.WriteLine($"VISA DC Load     [{dcLoadAddr}] : {dcIdn ?? "(no response)"}");
            Console.WriteLine($"VISA Power Meter [{powerMeterAddr}] : {pmIdn ?? "(no response)"}");

            var warn = new List<string>();
            if (visaSharedSession)
                warn.Add("DC Load and Power Meter point at the SAME address - every command goes to one instrument.");
            if (dcLoadSession != null && dcIdn == null)
                warn.Add("DC Load did not answer *IDN? - link is down or the instrument is busy.");
            if (powerMeterSession != null && pmIdn == null)
                warn.Add("Power Meter did not answer *IDN? - link is down or the instrument is busy.");

            if (warn.Count == 0)
            {
                SetStatus(StatusLevel.Info, "VISA connected and verified.");
                return;
            }

            SetStatus(StatusLevel.Warn,
                      "VISA connected with warnings: " + string.Join(" ", warn),
                      $"    DC Load     [{dcLoadAddr}]\r\n        {dcIdn ?? "(no response)"}\r\n" +
                      $"    Power Meter [{powerMeterAddr}]\r\n        {pmIdn ?? "(no response)"}");
        }

        // 健檢用的 *IDN?：失敗回 null 而不往外拋 —— 這只是連線後的體檢，
        // 不該讓 Connect 本身失敗（有些儀器開機初期會晚一點才回應）。
        // 逾時另外壓到 2 秒，避免兩台都不通時 Connect 卡上 10 秒。
        private string SafeIdn(MessageBasedSession session)
        {
            if (session == null) return null;
            int oldTimeout = session.TimeoutMilliseconds;
            try
            {
                session.TimeoutMilliseconds = 2000;
                session.RawIO.Write("*IDN?\n");
                return session.RawIO.ReadString().Trim();
            }
            catch (Exception ex)
            {
                Console.WriteLine("IDN health check failed: " + ex.Message);
                return null;
            }
            finally
            {
                try { session.TimeoutMilliseconds = oldTimeout; } catch { }
            }
        }

        private MessageBasedSession OpenVisaSession(string address)
        {
            var session = (MessageBasedSession)visaRm.Open(address);
            session.TimeoutMilliseconds = VisaTimeoutMs;

            // 以 LF 為結束字元，讓 ReadString() 讀到一行就返回，不必等到逾時。
            // 少了這一步，每個查詢都得等滿 5 秒才拿得到結果 —— 探測命令族時尤其致命。
            try
            {
                session.TerminationCharacter = 0x0A;
                session.TerminationCharacterEnabled = true;
            }
            catch { /* 少數介面不支援設定終止字元，忽略即可 */ }

            return session;
        }

        // 斷開所有 VISA 連線。quiet = true 用於連線失敗時的內部收尾，不覆蓋錯誤訊息。
        private void DisconnectVisa(bool quiet = false)
        {
            // 共用 session 時只能 Dispose 一次，先把別名清掉
            if (visaSharedSession) powerMeterSession = null;

            try { dcLoadSession?.Dispose(); } catch { }
            try { powerMeterSession?.Dispose(); } catch { }
            try { visaRm?.Dispose(); } catch { }

            dcLoadSession = null;
            powerMeterSession = null;
            visaRm = null;
            visaSharedSession = false;

            // 命令族是「這一台機器」的探測結果，斷線就作廢，
            // 否則換一台負載重新連線時會沿用上一台的命令。
            dcLoadCommands = null;
            powerMeterType = MeterType.Unknown;

            if (!quiet)
            {
                UpdateVisaUi();
                SetStatus(StatusLevel.Info, "VISA disconnected.");
            }
        }

        // 連線中鎖住下拉與 Scan，避免選項與實際開著的 session 不一致。
        private void UpdateVisaUi()
        {
            bool connected = VisaConnected;
            visa_connect_btn.Text = connected ? "Disconnect" : "Connect";
            dc_load_cbb.Enabled = !connected;
            power_meter_cbb.Enabled = !connected;
            scan_visa_btn.Enabled = !connected;
