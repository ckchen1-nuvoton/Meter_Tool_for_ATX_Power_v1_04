            // Chroma 66202 不支援 MEAS:xxx:DC? 命令，DC 模式也一律用 RMS 命令讀取，
            // 因此 DC Value 與 RMS Value 走的是同一段流程。
            await RunLoadSweepAsync(button14, button12, "button14_Click");
        }

        // 電流輸入兩種寫法都收：先試 "6.96"（不分地區），再試當地地區設定的寫法。
        // 原本用的 float.TryParse 只吃當地設定，改成只認 Invariant 反而會把原本
        // 能用的輸入擋掉 —— 兩邊都試才不會縮限使用者。
        // 注意這只管「讀進來」；送給儀器的字串一律走 InvariantCulture（見 DcLoadSetCurrentCommand）。
        private static bool TryParseCurrent(string text, out double value)
        {
            string s = (text ?? "").Trim();

            if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out value)) return true;
            if (double.TryParse(s, NumberStyles.Float, CultureInfo.CurrentCulture, out value)) return true;

            value = 0;
            return false;
        }

        // 掃描參數不合法時擋在流程外面，並指名是哪一格、現在填的是什麼、該填什麼。
        // 不用「Invalid input」這種看了也不知道要改哪裡的訊息。
        private void ShowSweepInputError(string field, string value, string expected)
        {
            string shown = string.IsNullOrWhiteSpace(value) ? "(empty)" : value.Trim();

            SetStatus(StatusLevel.Warn,
                      $"\"{field}\" is invalid ({shown}) - measurement not started. Expected {expected}.");
        }

        /// <summary>
        /// 5% ~ 100% 的負載掃描：每點設定電流 → 停留 Delay 秒 → 讀功率計、算誤差、寫檔與 Accuracy 表格。
        /// owner 是被按下的那顆按鈕（掃描期間變成 Stop），other 是掃描期間要停用的另一顆。
        /// </summary>
        async private Task RunLoadSweepAsync(Button owner, Button other, string context)
        {
            if (!serialPort1.IsOpen) return;

            BeginSweepUi(owner, other);
            CancellationToken ct = sweepCts.Token;

            try
            {
                // 電流命令下下去之前先把負載打開，否則整輪都在對一台沒接上的負載設定電流。
                if (!TurnOnDcLoad()) return;

                // 使用系統時間動態生成檔名，格式化為 "yyyyMMdd_HHmmss"
                string fileName = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                string filePath = $"output_{fileName}.txt"; // 組合成完整檔案路徑

                // 如果文件已經存在，刪除它以創建一個新的
                if (File.Exists(filePath))
                {
                    File.Delete(filePath);
                }

                // 初始化一個空文件
                using (StreamWriter sw = new StreamWriter(filePath))
                {
                    // 寫入表頭
                    //sw.WriteLine("Voltage RMS");
                }

                // ===== 讀取三個輸入框 =====
                // 原本三個 TryParse 的回傳值都被丟掉，解析失敗就悄悄拿 0 往下跑，
                // 而這三個框在 Designer 裡的預設值都是空字串。後果分別是：
                //   Delay  = 0 → 換完負載立刻讀值，功率計還沒重新量測、MCU 的 auto-report
                //                也還沒送出新的一幀，記下來的是「上一個負載點」的數值 ——
                //                整張表系統性偏移一格，畫面上完全看不出異狀。
                //   Repeat = 0 → 兩層迴圈一次都不跑，卻照樣跳「Successfully written」，檔案是空的。
                //   100%   = 0 → 每一點都送 0 A。
                // 這種錯誤不能默默吞掉，直接擋在流程外面並講清楚是哪一格。

                // 讀取100%電流規格
                // 宣告成 double 而非 float：float × int 會先在單精度算完才除以 100，
                // 光是這個中間型別就足以讓部分負載點的設定值差 0.01 A。
                double maxCurrent;
                if (!TryParseCurrent(curr_100p_box.Text, out maxCurrent) || maxCurrent <= 0)
                {
                    ShowSweepInputError("100% Current", curr_100p_box.Text, "a positive number, e.g. 6.96");
                    return;
                }
                Console.WriteLine(maxCurrent);

                // 讀取Delay sencond
                // 上限 3600 秒有兩個用途：擋掉手殘多打一個 0，
                // 也順便讓 delaySec * 1000 不可能撐爆 int。
                int delaySec;
                if (!int.TryParse(delay_sec_box.Text.Trim(), out delaySec) || delaySec < 0 || delaySec > 3600)
                {
                    ShowSweepInputError("Delay (sec)", delay_sec_box.Text, "an integer from 0 to 3600");
                    return;
                }
                Console.WriteLine(delaySec);

                // Delay 0 秒不是解析失敗，是使用者真的填 0 —— 合法但幾乎一定量錯，
                // 因為換點之後沒有任何穩定時間。擋不得，但要留下記錄。
                if (delaySec == 0)
                    Console.WriteLine("WARNING: Delay = 0 s, readings may still belong to the previous load point.");

                // 讀取Repeat
                int repeatTimes;
                if (!int.TryParse(repeat_box.Text.Trim(), out repeatTimes) || repeatTimes < 1)
                {
                    ShowSweepInputError("Repeat", repeat_box.Text, "an integer of 1 or more");
                    return;
                }
                Console.WriteLine(repeatTimes);

                // 重新量測 -> 先清空 Accuracy 分頁的舊資料
                ResetAccuracyTable();

                for (int repeatCount = 0; repeatCount < repeatTimes; repeatCount++)
                {
                    // 從5%到100%，每次增加5%
                    for (int percentage = 5; percentage <= 100; percentage += 5)
                    {
                        // 每個負載點開頭檢查一次；按下 Stop 後最晚在下一點開頭就會離開迴圈。
                        ct.ThrowIfCancellationRequested();

                        // 負載設定值宣告在 using 外面，後面累積 Accuracy 表格時要用到
                        // 保留2位小數。指定 AwayFromZero：Math.Round 的預設是銀行家捨入
                        // （遇到剛好 .5 進到偶數），會讓 max=0.5A 的 5% 變成 0.02 而不是 0.03，
                        // 而且同一輪裡有的點進、有的點捨，方向不一致。
                        double currentValue = Math.Round(maxCurrent * percentage / 100.0, 2,
                                                         MidpointRounding.AwayFromZero);

                        // 打開與設備的會話
                        {
                            // 使用 Connect 時建立的常駐 session
                            MessageBasedSession session = RequireDcLoadSession();
                            if (session == null) return;

                            Console.WriteLine($"Setting current to {percentage}% of {maxCurrent}A: {currentValue}A");

                            // 發送SCPI命令來設定電流值。命令前綴取自連線時探測到的命令族，
                            // 不再寫死 CURR:STAT:L1 —— 那只有 63xxx 認得。
                            string command = DcLoadSetCurrentCommand(currentValue);
                            VisaWrite(session, command);

                            // 每點都確認一次：電流超出機器的 LIMit 設定時，命令會被拒絕但外觀毫無異狀。
                            string setErr = DcLoadErrorText(session);
                            if (setErr != null) Console.WriteLine($"DC Load rejected [{command}] : {setErr}");
                        }

                        SetStatus(StatusLevel.Info, $"Sweeping {repeatCount + 1}/{repeatTimes} - {percentage}% ({currentValue:F2} A)");

                        // 等待（帶取消權杖，停留期間按 Stop 就立刻中斷，不必等這一點跑完）
                        await Task.Delay(delaySec * 1000, ct);  // 非同步延遲

                        // 打開與設備的會話
                        {
                            // 使用 Connect 時建立的常駐 session
                            MessageBasedSession session = RequirePowerMeterSession();
                            if (session == null) return;

                            // 讀取 V / I / P（依 IDN 自動切換 Chroma / Yokogawa 命令集）
                            ReadPowerMeterRaw(session, out string voltageRmsResponse,
                                              out string currentRmsResponse, out string powerResponse);

                            // 清空 RichTextBox 控制元件內容
                            chroma_box.Clear();

                            // 將讀取到的數據顯示在 richTextBox1 中
                            chroma_box.Text = voltageRmsResponse + currentRmsResponse + powerResponse;
                            //chroma_box.AppendText(percentage.ToString());

                            chroma_box.AppendText($"{repeatCount + 1}\n");
                            chroma_box.AppendText($"{percentage:F2}%\n");

                            // 增加格式化後的數據顯示
                            //chroma_box.AppendText("\n\n");
                            //chroma_box.AppendText(vrms_float.ToString("N2") + "\n");
                            //chroma_box.AppendText(irms_float.ToString("N5") + "\n");
                            //chroma_box.AppendText(power_float.ToString("N3") + "\n");


                            // 模擬得到的6筆數值數據
                            double[] values = new double[6];

                            double voltageRmsValue;
                            double.TryParse(voltageRmsResponse, out voltageRmsValue);
                            values[0] = voltageRmsValue;

                            double currentRmsValue;
                            double.TryParse(currentRmsResponse, out currentRmsValue);
                            values[1] = currentRmsValue;

                            double powerValue;
                            double.TryParse(powerResponse, out powerValue);
                            values[2] = powerValue;

                            values[3] = vrms_float;
                            values[4] = irms_float;
                            values[5] = power_float;

                            values[3] = Math.Round(vrms_float, 2); // 保留2位小數
                            values[4] = Math.Round(irms_float, 5); // 保留5位小數
                            values[5] = Math.Round(power_float, 3); // 保留3位小數

                            // 清空 RichTextBox 控制元件內容
                            error_rate.Clear();

                            // 將讀取到的數據顯示在 richTextBox2 中
                            if (voltageRmsValue != 0)
                            {
                                double voltage_error_rate;
                                voltage_error_rate = ((voltageRmsValue - vrms_float) / voltageRmsValue) * 100.0;
                                error_rate.AppendText($"{voltage_error_rate:F2}%\n");
                            }

                            if (currentRmsValue != 0)
                            {
                                double current_error_rate;
                                current_error_rate = ((currentRmsValue - irms_float) / currentRmsValue) * 100.0;
                                error_rate.AppendText($"{current_error_rate:F2}%\n");
                            }

                            if (powerValue != 0)
                            {
                                double power_error_rate;
                                power_error_rate = ((powerValue - power_float) / powerValue) * 100.0;
                                error_rate.AppendText($"{power_error_rate:F2}%\n");
                            }

                            // 累積這個負載點到 Accuracy 分頁的表格
                            // (error_rate 這個文字框每輪都會被 Clear，只看得到最後一點；
                            //  表格才是完整的 5%~100% 誤差列表)
                            AddSweepPoint(percentage, currentValue,
                                          voltageRmsValue, currentRmsValue, powerValue,
                                          vrms_float, irms_float, power_float);

                            // 讀取當前的文件內容並拆分成多行
                            string[] fileLines = File.Exists(filePath) ? File.ReadAllLines(filePath) : new string[6];

                            // 確保文件中有6行（對應6筆數據）
                            if (fileLines.Length < 6)
                            {
                                Array.Resize(ref fileLines, 6); // 如果不足6行，則擴展到6行
                            }

                            // 打開文件以追加方式寫入
                            using (StreamWriter sw = new StreamWriter(filePath))
                            {
                                for (int i = 0; i < 6; i++)
                                {
                                    string formattedValue;

                                    // 根據索引設置不同的小數位格式
                                    if (i == 0)
                                    {
                                        formattedValue = values[i].ToString("F2");  // 第一筆到小數點第2位
                                    }
                                    else if (i == 1)
                                    {
                                        formattedValue = values[i].ToString("F4");  // 第二筆到小數點第4位
                                    }
                                    else if (i == 2)
                                    {
                                        formattedValue = values[i].ToString("F2");  // 第三筆到小數點第2位
                                    }
                                    else if (i == 3)
                                    {
                                        formattedValue = values[i].ToString("F2");  // 第四筆到小數點第2位
                                    }
                                    else if (i == 4)
                                    {
                                        formattedValue = values[i].ToString("F5");  // 第五筆到小數點第5位
                                    }
                                    else // i == 5
                                    {
                                        formattedValue = values[i].ToString("F3");  // 第六筆到小數點第3位
                                    }

                                    // 將當前數據附加到每一行的末尾，如果行為null則設置為空字符串
                                    if (string.IsNullOrEmpty(fileLines[i]))
                                    {
                                        fileLines[i] = formattedValue; // 新行
                                    }
                                    else
                                    {
                                        fileLines[i] += $"\t{formattedValue}"; // 將數值附加到現有行，使用制表符分隔
                                    }
                                }

                                // 將修改後的內容寫回文件
                                foreach (var line in fileLines)
                                {
                                    sw.WriteLine(line);
                                }
                            }

                        }
                    }
                }

                // 全部量測完成 -> 電流歸零並關閉負載。
                TurnOffDcLoad();
                SetStatus(StatusLevel.Info, $"Sweep completed - DC Load OFF, saved to {filePath}");
            }
            catch (OperationCanceledException)
            {
                // 使用者按下 Stop：負載由 finally 統一關閉。
                // 中斷是自己按的，不必再跳視窗擋著，狀態列講一聲就好。
                SetStatus(StatusLevel.Warn, "Measurement stopped. DC Load OFF.");
                Console.WriteLine("Sweep stopped by user.");
            }
            catch (VisaException ex)
            {
                ShowVisaError(ex, context);
            }
            finally
            {
                // 中途 return、丟例外或被中斷都會走到這裡，負載絕不會被留在 ON 的狀態。
                TurnOffDcLoad();
                EndSweepUi(other);
            }
        }

