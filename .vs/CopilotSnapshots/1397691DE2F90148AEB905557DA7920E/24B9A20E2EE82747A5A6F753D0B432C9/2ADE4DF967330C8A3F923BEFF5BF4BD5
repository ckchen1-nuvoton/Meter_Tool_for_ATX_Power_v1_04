        private void serialLoad()
        {
            RegistryKey keyCom = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DeviceMap\SerialComm");

            if (keyCom != null)
            {
                try
                {
                    string[] sSubKeys = keyCom.GetValueNames();
                    port_cbb.Items.Clear();

                    foreach (var sValue in sSubKeys)
                    {
                        string portName = (string)keyCom.GetValue(sValue);

                        // Filter and only add COM1 ~ COM99
                        if (portName.StartsWith("COM"))
                        {
                            string numberPart = portName.Substring(3);
                            if (int.TryParse(numberPart, out int portNumber) && portNumber >= 1 && portNumber <= 99)
                            {
                                port_cbb.Items.Add(portName);
                            }
                        }
                    }

                    if (port_cbb.Items.Count > 0)
                        port_cbb.SelectedIndex = 0;

                    keyCom.Close();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Exception occurred: {ex.Message}");
                }
            }
            else
            {
                Console.WriteLine("Specified registry key not found.");
            }
        }


