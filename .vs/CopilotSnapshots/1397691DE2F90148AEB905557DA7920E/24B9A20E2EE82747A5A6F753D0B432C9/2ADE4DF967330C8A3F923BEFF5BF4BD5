        private CalibrationResult CalculateCalibration(string filePath)
        {
            CalibrationData data = LoadCalibrationData(filePath);

            CalibrationResult result =
                FindBestCurrentCompensation(data);

            FindBestVoltageDropResistance(data, result);
            FindBestPowerCompensation(data, result);

            return result;
        }

