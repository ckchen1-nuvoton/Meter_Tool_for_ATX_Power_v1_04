        private void SetRequiredTextBoxValue(
            string controlName,
            double value)
        {
            Control[] controls = Controls.Find(controlName, true);

            if (controls.Length == 0 ||
                !(controls[0] is System.Windows.Forms.TextBox))
            {
                throw new InvalidOperationException(
                    $"Please set the AC230V TextBox (Name) to '{controlName}'.");
            }

            System.Windows.Forms.TextBox textBox =
                (System.Windows.Forms.TextBox)controls[0];

            textBox.Text = value.ToString(
                "F6",
                CultureInfo.InvariantCulture);
        }

        private void ClearTextBoxIfFound(string controlName)
        {
            Control[] controls = Controls.Find(controlName, true);

            if (controls.Length > 0 &&
                controls[0] is System.Windows.Forms.TextBox)
            {
                ((System.Windows.Forms.TextBox)controls[0]).Clear();
            }
        }

