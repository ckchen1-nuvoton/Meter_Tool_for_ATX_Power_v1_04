        #region AC230V light-load current compensation

        private Ac230LightLoadResult CalculateAc230LightLoadParameters(
            string filePath)
        {
            CalibrationData data = LoadCalibrationData(filePath);

            double currentGain50 =
                data.ReferenceCurrent[CalibrationPoint50Percent] /
                data.RawCurrent[CalibrationPoint50Percent];

            double[] correctedCurrent = new double[data.Count];
            double[] compensationRatio = new double[data.Count];

            for (int i = 0; i < data.Count; i++)
            {
                // x：先經過50%一點校正的電流
                correctedCurrent[i] =
                    data.RawCurrent[i] * currentGain50;

                if (Math.Abs(correctedCurrent[i]) < 1e-12)
                {
                    throw new InvalidDataException(
                        $"Corrected current at point {i + 1} cannot be zero.");
                }

                // y：輕載補償倍率
                compensationRatio[i] =
                    data.ReferenceCurrent[i] /
                    correctedCurrent[i];
            }

            // 5%公式使用5%與10%兩點求一次式
            double x5 = correctedCurrent[0];
            double y5 = compensationRatio[0];
            double x10 = correctedCurrent[1];
            double y10 = compensationRatio[1];

            if (Math.Abs(x10 - x5) < 1e-12)
            {
                throw new InvalidDataException(
                    "The corrected currents at 5% and 10% cannot be identical.");
            }

            double linearA =
                (y10 - y5) / (x10 - x5);

            double linearB =
                y5 - linearA * x5;

            // 10%、15%、20%、25%四點做二次最小平方擬合
            double[] quadraticParameters = FitQuadraticCurve(
                correctedCurrent,
                compensationRatio,
                1,
                4);

            // 計算經過50%校正及輕載補償後的電流誤差
            double currentTotalAbsoluteError = 0.0;
            double currentMaximumAbsoluteError = 0.0;

            for (int i = 0; i < data.Count; i++)
            {
                double current = correctedCurrent[i];
                double lightLoadRatio = 1.0;

                if (i == 0)
                {
                    lightLoadRatio =
                        linearA * current + linearB;
                }
                else if (i >= 1 && i <= 4)
                {
                    lightLoadRatio =
                        quadraticParameters[0] * current * current +
                        quadraticParameters[1] * current +
                        quadraticParameters[2];
                }

                double finalCurrent =
                    current * lightLoadRatio;

                double absoluteError = Math.Abs(
                    CalculateErrorPercent(
                        finalCurrent,
                        data.ReferenceCurrent[i]));

                currentTotalAbsoluteError += absoluteError;
                currentMaximumAbsoluteError = Math.Max(
                    currentMaximumAbsoluteError,
                    absoluteError);
            }

            double currentAverageError =
                currentTotalAbsoluteError / data.Count;

            double[] voltageDropResult =
                FindBestAc230VoltageDropResistance(
                    data,
                    correctedCurrent,
                    linearA,
                    linearB,
                    quadraticParameters[0],
                    quadraticParameters[1],
                    quadraticParameters[2]);

            // AC230V功率補償：先套用電壓與電流的50%比例，
            // 再搜尋使全量程平均絕對誤差最小的補償值。
            CalibrationResult powerResult =
                new CalibrationResult();

            FindBestPowerCompensation(
                data,
                powerResult);

            return new Ac230LightLoadResult
            {
                CurrentGain50 = currentGain50,
                CurrentAverageError = currentAverageError,
                CurrentMaximumError = currentMaximumAbsoluteError,
                LinearA = linearA,
                LinearB = linearB,
                QuadraticA = quadraticParameters[0],
                QuadraticB = quadraticParameters[1],
                QuadraticC = quadraticParameters[2],
                VoltageDropResistance = voltageDropResult[0],
                VoltageGain50 = voltageDropResult[1],
                VoltageAverageError = voltageDropResult[2],
                VoltageMaximumError = voltageDropResult[3],
                PowerCompensation = powerResult.PowerCompensation,
                PowerGain50 = powerResult.PowerGain50,
                PowerAverageError = powerResult.PowerAverageError,
                PowerMaximumError = powerResult.PowerMaximumError
            };
        }

        private double[] FindBestAc230VoltageDropResistance(
            CalibrationData data,
            double[] currentAfter50PercentCalibration,
            double linearA,
            double linearB,
            double quadraticA,
            double quadraticB,
            double quadraticC)
        {
            double[] finalCorrectedCurrent =
                new double[data.Count];

            for (int i = 0; i < data.Count; i++)
            {
                double current =
                    currentAfter50PercentCalibration[i];

                double lightLoadRatio = 1.0;

                if (i == 0)
                {
                    // 5%輕載使用一次方程式
                    lightLoadRatio =
                        linearA * current + linearB;
                }
                else if (i >= 1 && i <= 4)
                {
                    // 10%~25%輕載使用二次方程式
                    lightLoadRatio =
                        quadraticA * current * current +
                        quadraticB * current +
                        quadraticC;
                }

                finalCorrectedCurrent[i] =
                    current * lightLoadRatio;
            }

            double bestResistance = 0.0;
            double bestGain50 = 0.0;
            double bestAverageError = double.MaxValue;
            double bestMaximumError = double.MaxValue;

            int searchCount = (int)Math.Round(
                (VoltageDropResistanceMax - VoltageDropResistanceMin) /
                VoltageDropResistanceStep);

            for (int n = 0; n <= searchCount; n++)
            {
                double resistance =
                    VoltageDropResistanceMin +
                    n * VoltageDropResistanceStep;

                // Vcomp = Vraw + Ifinal * Rvdrop
                double compensatedVoltageAt50 =
                    data.RawVoltage[CalibrationPoint50Percent] +
                    finalCorrectedCurrent[CalibrationPoint50Percent] *
                    resistance;

                if (Math.Abs(compensatedVoltageAt50) < 1e-12)
                    continue;

                // Rvdrop後再使用50%負載做電壓一點校正
                double gain50 =
                    data.ReferenceVoltage[CalibrationPoint50Percent] /
                    compensatedVoltageAt50;

                double totalAbsoluteError = 0.0;
                double maximumAbsoluteError = 0.0;

                for (int i = 0; i < data.Count; i++)
                {
                    double compensatedVoltage =
                        data.RawVoltage[i] +
                        finalCorrectedCurrent[i] * resistance;

                    double correctedVoltage =
                        compensatedVoltage * gain50;

                    double absoluteError = Math.Abs(
                        CalculateErrorPercent(
                            correctedVoltage,
                            data.ReferenceVoltage[i]));

                    totalAbsoluteError += absoluteError;
                    maximumAbsoluteError = Math.Max(
                        maximumAbsoluteError,
                        absoluteError);
                }

                double averageError =
                    totalAbsoluteError / data.Count;

                if (averageError < bestAverageError)
                {
                    bestResistance = resistance;
                    bestGain50 = gain50;
                    bestAverageError = averageError;
                    bestMaximumError = maximumAbsoluteError;
                }
            }

            return new[]
            {
                bestResistance,
                bestGain50,
                bestAverageError,
                bestMaximumError
            };
        }

        private double[] FitQuadraticCurve(
            double[] x,
            double[] y,
            int startIndex,
            int endIndex)
        {
            double sumX = 0.0;
            double sumX2 = 0.0;
            double sumX3 = 0.0;
            double sumX4 = 0.0;
            double sumY = 0.0;
            double sumXY = 0.0;
            double sumX2Y = 0.0;

            int pointCount = endIndex - startIndex + 1;

            for (int i = startIndex; i <= endIndex; i++)
            {
                double x2 = x[i] * x[i];
                double x3 = x2 * x[i];
                double x4 = x2 * x2;

                sumX += x[i];
                sumX2 += x2;
                sumX3 += x3;
                sumX4 += x4;
                sumY += y[i];
                sumXY += x[i] * y[i];
                sumX2Y += x2 * y[i];
            }

            double[,] augmentedMatrix =
            {
                { sumX4, sumX3, sumX2, sumX2Y },
                { sumX3, sumX2, sumX,  sumXY  },
                { sumX2, sumX,  pointCount, sumY }
            };

            return SolveThreeVariableEquation(augmentedMatrix);
        }

        private double[] SolveThreeVariableEquation(double[,] matrix)
        {
            const int variableCount = 3;

            for (int column = 0; column < variableCount; column++)
            {
                int pivotRow = column;

                for (int row = column + 1; row < variableCount; row++)
                {
                    if (Math.Abs(matrix[row, column]) >
                        Math.Abs(matrix[pivotRow, column]))
                    {
                        pivotRow = row;
                    }
                }

                if (Math.Abs(matrix[pivotRow, column]) < 1e-15)
                {
                    throw new InvalidOperationException(
                        "The AC230V quadratic fitting matrix cannot be solved.");
                }

                if (pivotRow != column)
                {
                    for (int j = column; j <= variableCount; j++)
                    {
                        double temporary = matrix[column, j];
                        matrix[column, j] = matrix[pivotRow, j];
                        matrix[pivotRow, j] = temporary;
                    }
                }

                double pivot = matrix[column, column];

                for (int j = column; j <= variableCount; j++)
                {
                    matrix[column, j] /= pivot;
                }

                for (int row = 0; row < variableCount; row++)
                {
                    if (row == column)
                        continue;

                    double factor = matrix[row, column];

                    for (int j = column; j <= variableCount; j++)
                    {
                        matrix[row, j] -=
                            factor * matrix[column, j];
                    }
                }
            }

            return new[]
            {
                matrix[0, 3],
                matrix[1, 3],
                matrix[2, 3]
            };
        }

        #endregion

        #region TXT loading and validation

        private CalibrationData LoadCalibrationData(string filePath)
        {
            string[] lines = File.ReadAllLines(filePath)
                .Where(line => !string.IsNullOrWhiteSpace(line))
                .ToArray();

            /*
             * TXT格式：
             * 第1列 Reference/Chroma Vrms
             * 第2列 Reference/Chroma Irms
             * 第3列 Reference/Chroma Active Power
             * 第4列 NADC24 Raw Vrms
             * 第5列 NADC24 Raw Irms
             * 第6列 NADC24 Raw Active Power
             */
            if (lines.Length < 6)
            {
                throw new InvalidDataException(
                    "TXT file must contain at least 6 non-empty rows.");
            }

            CalibrationData data = new CalibrationData
            {
                ReferenceVoltage = ParseDataLine(lines[0], 1),
                ReferenceCurrent = ParseDataLine(lines[1], 2),
                ReferencePower = ParseDataLine(lines[2], 3),
                RawVoltage = ParseDataLine(lines[3], 4),
                RawCurrent = ParseDataLine(lines[4], 5),
                RawPower = ParseDataLine(lines[5], 6)
            };

            ValidateCalibrationData(data);
            return data;
        }

        private double[] ParseDataLine(string line, int rowNumber)
        {
            string[] values = line.Split(
                new[] { '\t', ' ', ',' },
                StringSplitOptions.RemoveEmptyEntries);

            try
            {
                return values
                    .Select(value => double.Parse(
                        value,
                        NumberStyles.Float,
                        CultureInfo.InvariantCulture))
                    .ToArray();
            }
            catch (FormatException)
            {
                throw new InvalidDataException(
                    $"TXT row {rowNumber} contains invalid numeric data.");
            }
            catch (OverflowException)
            {
                throw new InvalidDataException(
                    $"TXT row {rowNumber} contains a number outside the valid range.");
            }
        }

        private void ValidateCalibrationData(CalibrationData data)
        {
            if (data.Count <= CalibrationPoint50Percent)
            {
                throw new InvalidDataException(
                    "At least 10 load points are required for 50% calibration.");
            }

            int expectedCount = data.Count;

            if (data.ReferenceCurrent.Length != expectedCount ||
                data.ReferencePower.Length != expectedCount ||
                data.RawVoltage.Length != expectedCount ||
                data.RawCurrent.Length != expectedCount ||
                data.RawPower.Length != expectedCount)
            {
                throw new InvalidDataException(
                    "All six TXT rows must contain the same number of data points.");
            }

            ValidateNonZeroReferences(
                data.ReferenceVoltage,
                "voltage");

            ValidateNonZeroReferences(
                data.ReferenceCurrent,
                "current");

            ValidateNonZeroReferences(
                data.ReferencePower,
                "power");
        }

        private void ValidateNonZeroReferences(
            double[] values,
            string measurementName)
        {
            for (int i = 0; i < values.Length; i++)
            {
                if (Math.Abs(values[i]) < 1e-12)
                {
                    throw new InvalidDataException(
                        $"Reference {measurementName} at point {i + 1} cannot be zero.");
                }
            }
        }

        #endregion

        #region Current compensation

        private CalibrationResult FindBestCurrentCompensation(
            CalibrationData data)
        {
            double bestCompensation = 0.0;
            double bestGain50 = 0.0;
            double bestAverageError = double.MaxValue;
            double bestMaximumError = double.MaxValue;

            int searchCount = (int)Math.Round(
                (CurrentCompensationMax - CurrentCompensationMin) /
                CurrentCompensationStep);

            for (int n = 0; n <= searchCount; n++)
            {
                double compensation =
                    CurrentCompensationMin +
                    n * CurrentCompensationStep;

                // 先加I Comp，再用50%負載點計算Current Gain
                double compensatedCurrentAt50 =
                    data.RawCurrent[CalibrationPoint50Percent] +
                    compensation;

                if (Math.Abs(compensatedCurrentAt50) < 1e-12)
                    continue;

                double gain50 =
                    data.ReferenceCurrent[CalibrationPoint50Percent] /
                    compensatedCurrentAt50;

                double totalAbsoluteError = 0.0;
                double maximumAbsoluteError = 0.0;

                for (int i = 0; i < data.Count; i++)
                {
                    double correctedCurrent =
                        (data.RawCurrent[i] + compensation) *
                        gain50;

                    double errorPercent = CalculateErrorPercent(
                        correctedCurrent,
                        data.ReferenceCurrent[i]);

                    double absoluteError = Math.Abs(errorPercent);
                    totalAbsoluteError += absoluteError;
                    maximumAbsoluteError = Math.Max(
                        maximumAbsoluteError,
                        absoluteError);
                }

                double averageError =
                    totalAbsoluteError / data.Count;

                if (averageError < bestAverageError)
                {
                    bestCompensation = compensation;
                    bestGain50 = gain50;
                    bestAverageError = averageError;
                    bestMaximumError = maximumAbsoluteError;
                }
            }

            return new CalibrationResult
            {
                CurrentCompensation = bestCompensation,
                CurrentGain50 = bestGain50,
                CurrentAverageError = bestAverageError,
                CurrentMaximumError = bestMaximumError
            };
        }

        #endregion

        #region Voltage drop resistance compensation

        private void FindBestVoltageDropResistance(
            CalibrationData data,
            CalibrationResult result)
        {
            double[] correctedCurrent = new double[data.Count];

            for (int i = 0; i < data.Count; i++)
            {
                correctedCurrent[i] =
                    (data.RawCurrent[i] + result.CurrentCompensation) *
                    result.CurrentGain50;
            }

            double bestResistance = 0.0;
            double bestGain50 = 0.0;
            double bestAverageError = double.MaxValue;
            double bestMaximumError = double.MaxValue;

            int searchCount = (int)Math.Round(
                (VoltageDropResistanceMax - VoltageDropResistanceMin) /
                VoltageDropResistanceStep);

            for (int n = 0; n <= searchCount; n++)
            {
                double resistance =
                    VoltageDropResistanceMin +
                    n * VoltageDropResistanceStep;

                // Vcomp = Vraw + Icorrected * Rvdrop
                double compensatedVoltageAt50 =
                    data.RawVoltage[CalibrationPoint50Percent] +
                    correctedCurrent[CalibrationPoint50Percent] *
                    resistance;

                if (Math.Abs(compensatedVoltageAt50) < 1e-12)
                    continue;

                double gain50 =
                    data.ReferenceVoltage[CalibrationPoint50Percent] /
                    compensatedVoltageAt50;

                double totalAbsoluteError = 0.0;
                double maximumAbsoluteError = 0.0;

                for (int i = 0; i < data.Count; i++)
                {
                    double compensatedVoltage =
                        data.RawVoltage[i] +
                        correctedCurrent[i] * resistance;

                    double correctedVoltage =
                        compensatedVoltage * gain50;

                    double errorPercent = CalculateErrorPercent(
                        correctedVoltage,
                        data.ReferenceVoltage[i]);

                    double absoluteError = Math.Abs(errorPercent);
                    totalAbsoluteError += absoluteError;
                    maximumAbsoluteError = Math.Max(
                        maximumAbsoluteError,
                        absoluteError);
                }

                double averageError =
                    totalAbsoluteError / data.Count;

                if (averageError < bestAverageError)
                {
                    bestResistance = resistance;
                    bestGain50 = gain50;
                    bestAverageError = averageError;
                    bestMaximumError = maximumAbsoluteError;
                }
            }

            result.VoltageDropResistance = bestResistance;
            result.VoltageGain50 = bestGain50;
            result.VoltageAverageError = bestAverageError;
            result.VoltageMaximumError = bestMaximumError;
        }

        #endregion

        #region Power compensation

        private void FindBestPowerCompensation(
            CalibrationData data,
            CalibrationResult result)
        {
            /*
             * 與Excel公式一致：
             * Ptemp = Praw * VoltageRatio50 * CurrentRatio50 + PComp
             * Pfinal = Ptemp * PowerGain50
             */
            double voltageRatio50 =
                data.ReferenceVoltage[CalibrationPoint50Percent] /
                data.RawVoltage[CalibrationPoint50Percent];

            double currentRatio50 =
                data.ReferenceCurrent[CalibrationPoint50Percent] /
                data.RawCurrent[CalibrationPoint50Percent];

            double bestCompensation = 0.0;
            double bestGain50 = 0.0;
            double bestAverageError = double.MaxValue;
            double bestMaximumError = double.MaxValue;

            int searchCount = (int)Math.Round(
                (PowerCompensationMax - PowerCompensationMin) /
                PowerCompensationStep);

            for (int n = 0; n <= searchCount; n++)
            {
                double compensation =
                    PowerCompensationMin +
                    n * PowerCompensationStep;

                double compensatedPowerAt50 =
                    data.RawPower[CalibrationPoint50Percent] *
                    voltageRatio50 *
                    currentRatio50 +
                    compensation;

                if (Math.Abs(compensatedPowerAt50) < 1e-12)
                    continue;

                double gain50 =
                    data.ReferencePower[CalibrationPoint50Percent] /
                    compensatedPowerAt50;

                double totalAbsoluteError = 0.0;
                double maximumAbsoluteError = 0.0;

                for (int i = 0; i < data.Count; i++)
                {
                    double compensatedPower =
                        data.RawPower[i] *
                        voltageRatio50 *
                        currentRatio50 +
                        compensation;

                    double correctedPower =
                        compensatedPower * gain50;

                    double errorPercent = CalculateErrorPercent(
                        correctedPower,
                        data.ReferencePower[i]);

                    double absoluteError = Math.Abs(errorPercent);
                    totalAbsoluteError += absoluteError;
                    maximumAbsoluteError = Math.Max(
                        maximumAbsoluteError,
                        absoluteError);
                }

                double averageError =
                    totalAbsoluteError / data.Count;

                if (averageError < bestAverageError)
                {
                    bestCompensation = compensation;
                    bestGain50 = gain50;
                    bestAverageError = averageError;
                    bestMaximumError = maximumAbsoluteError;
                }
            }

            result.PowerCompensation = bestCompensation;
            result.PowerGain50 = bestGain50;
            result.PowerAverageError = bestAverageError;
            result.PowerMaximumError = bestMaximumError;
        }

