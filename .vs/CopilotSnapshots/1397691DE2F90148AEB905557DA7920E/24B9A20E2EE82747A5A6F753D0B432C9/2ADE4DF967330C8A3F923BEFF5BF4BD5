        private CalibrationResult SelectAndCalculateCalibrationFile(
            string calibrationMode,
            out string selectedFilePath)
        {
            selectedFilePath = null;

            using (OpenFileDialog dialog = new OpenFileDialog())
            {
                dialog.Title = $"Select {calibrationMode} Raw Data";
                dialog.Filter =
                    "TXT files (*.txt)|*.txt|" +
                    "All files (*.*)|*.*";
